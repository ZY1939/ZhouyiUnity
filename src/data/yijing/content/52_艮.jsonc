  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "艮其趾，无咎，利永贞。",
      "xiang": "“艮其趾”，未失正也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "艮其腓，不拯其随，其心不快。",
      "xiang": "“不拯其随”，未退听也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "艮其限，列其夤，厉熏心。",
      "xiang": "“艮其限”，危“熏心”也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "艮其身，无咎。",
      "xiang": "“艮其身”，止诸躬也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "艮其辅，言有序，悔亡。",
      "xiang": "“艮其辅”，以中正也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "敦艮，吉。",
      "xiang": "“敦艮”之“吉”，以厚终也。",
      "nishi": "（待补充）"
    }
  ],
