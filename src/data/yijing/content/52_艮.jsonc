  "id": 52,
  "name": "艮",
  "full_name": "艮为山",
  "symbol": "䷳",
  "binary": "001001",
  "upper": "艮",
  "lower": "艮",
  "scripture": "艮其背，不获其身；行其庭，不见其人，无咎。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "艮，止也。时止则止，时行则行；动静不失其时，其道光明。艮其止，止其所也。上下敌应，不相与也。是以“不获其身，行其庭，不见其人，无咎”也。",
  "daxiang": "兼山，艮。君子以思不出其位。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 40,
  "huguaName": "雷水解",

