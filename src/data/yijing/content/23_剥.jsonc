  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "剥床以足，蔑贞；凶。",
      "xiang": "“剥床以足”，以灭下也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "剥床以辨，蔑贞凶。",
      "xiang": "“剥床以辨”，未有与也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "剥之，无咎。",
      "xiang": "“剥之，无咎”，失上下也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "剥床以肤，凶。",
      "xiang": "“剥床以肤”，切近灾也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "贯鱼以宫人宠，无不利。",
      "xiang": "“以宫人宠”，终无尤也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "硕果不食，君子得舆，小人剥庐。",
      "xiang": "“君子得舆”，民所载也；“小人剥庐”，终不可用也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
  },
  "{path}": ["一、婦人床上坐:必有暗災,陰人得勢,陽道衰弱,小人為主官。", "二、燭在風中:險也。", "三、葫蘆:醫藥無救也;有暗計也。", "四、繅絲:事務繁冗。", "五、山下官人坐:有靠山,但陰人為禍。", "六、冠巾掛木上:求去之象;又有樂之象。"]
