  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "井泥不食，旧井无禽。",
      "xiang": "“井泥不食”，下也；“旧井无禽”，时舍也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "井谷射鲋，瓮敝漏。",
      "xiang": "“井谷射鲋”，无与也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "井渫不食，为我心恻；可用汲，王明，并受其福。",
      "xiang": "“井渫不食”，行恻也；求“王明”，受福也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "井甃，无咎。",
      "xiang": "“井甃，无咎”，修井也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "井冽，寒泉食。",
      "xiang": "“寒泉”之“食”，中正也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "井收勿幕，有孚元吉。",
      "xiang": "“元吉”在上，大成也。",
      "nishi": "（待补充）"
    }
  ],
