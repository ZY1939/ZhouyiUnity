  "id": 48,
  "name": "井",
  "full_name": "水风井",
  "symbol": "䷯",
  "binary": "011010",
  "upper": "坎",
  "lower": "巽",
  "scripture": "改邑不改井，无丧无得，往来井井；汔至，亦未繘井，羸其瓶，凶。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "巽乎水而上水，井；井养而不穷也。“改邑不改井”，乃以刚中也。“汔至，亦未繘井”，未有功也。“羸其瓶”，是以凶也。",
  "daxiang": "木上有水，井。君子以劳民劝相。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 38,
  "huguaName": "火泽睽",

  // ═════════════════════════════════════════════
  //  象课
  // ═════════════════════════════════════════════
