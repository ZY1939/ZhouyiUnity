  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "师出以律，否臧凶。",
      "xiang": "“师出以律”，失律“凶”也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "在师中吉，无咎；王三锡命。",
      "xiang": "“在师中吉”，承天宠也；“王三锡命”，怀万邦也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "师或舆尸，凶。",
      "xiang": "“师或舆尸”，大无功也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "师左次，无咎。",
      "xiang": "“左次，无咎”，未失常也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "田有禽，利执言，无咎；长子帅师，弟子舆尸，贞凶。",
      "xiang": "“长子帅师”，以中行也；“弟子舆师”，使不当也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "大君有命，开国承家，小人勿用。",
      "xiang": "“大君有命”，以正功也；“小人勿用”，必乱邦也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
  },
  "{path}": ["一、肖虎、馬、羊之人三合:可戰。", "二、文武二官綬印:得萬人服之帥。", "三、人立棋盤上:圍棋愈下愈多,但須有謀略方可成事。", "四、將軍臺上立:示有兵權也。生殺之專權也。武職大利。", "五、羊回首:回陽也,病危之人卜之,有自陰間回陽間之象。", "六、虎在馬後:為馬之靠山,馬因虎威而動。故馬回首視虎。"]
