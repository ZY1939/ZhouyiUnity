  "id": 41,
  "name": "损",
  "full_name": "山泽损",
  "fullName_tc": "山澤損",
  "symbol": "䷨",
  "binary": "110001",
  "upper": "艮",
  "lower": "兑",
  "scripture": "有孚，元吉，无咎，可贞，利有攸往。曷之用？二簋可用享。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "损，损下益上，其道上行。损而“有孚，元吉，无咎，可贞，利有攸往。曷之用？二簋可用享。”二簋应有时，损刚益柔有时，损益盈虚，与时偕行。",
  "daxiang": "山下有泽，损。君子以惩忿窒欲。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 24,
  "huguaName": "地雷复",

  // ═════════════════════════════════════════════
  //  象课
  // ═════════════════════════════════════════════
  "xiang_ke": {
    "xiang": "鑿石見玉之課",
    "ke": "握土爲山之象"
  },

  // ═════════════════════════════════════════════
  //  倪师卦解、占卜、阳宅、批八字
  // ═════════════════════════════════════════════
  "nishi": {
    "interpretation": "解,散也,斥去也,其後必有所失,故損為序。此卦「艮」上「兑」下,山體高在上而澤 體深在下乃有損下益上之義。如損上而益下,為益卦,取下而求益上,則為損,故居人上而施 恩澤於下則益,如取下而求自足,乃損。\n",
    "diagram": {
      "description": [
        "一、二人對酌:二人夾木,來也。 二、酒瓶倒案之:目前無指望也。",
        "三、毬在地上:所求不成狀。",
        "四、文書二策有再告二字:再次求,方成。"
      ],
      "image_path": "",
      "content": "二人對酌,酒瓶倒案上,毬在地上, 二人對酌,酒瓶倒案上,毬在地上,二人對酌,酒瓶倒案上,毬在地上,二人對酌,酒瓶倒案上,毬在地上, 文書二策,有再告二字。 文書二策,有再告二字。文書二策,有再告二字。"
    },
    "home": {
      "member": "少男",
      "direction": "西",
      "description": [
        "損局在陽宅上造成兒子問題多多，父母總是煩心擔憂。",
        "一、與同時生人，婚事延後一年方成，對方同一人。",
        "二、官運不通，所求不成。",
        "三、性喜求樂，不求進步，須經二次大災，方能悟。",
        "四、對家庭態度，只會花錢，不會賺錢，無所事事。"
      ]
    },
    "heluo": {
      "xiantian": [
        "第一个，三人损一人，攀龙附凤，求功名。",
        "第二个，这种八字呢，始成终败，为定数，就是为定限。",
        "第三个，举人终生，你一生做举人就行了，举人终生一生平安，千万不要贪多。",
        "第四个，那父不父，子不子，中间有个不完妻。"
      ],
      "houtian": [
        "后天卦，如果后天卦遇到损卦。",
        "第一个，明月当空，我们的月有很多解释，明月当空，清闲度日，明白我的意思。",
        "第二个，遇到损卦的时候，后天卦，遇事力求反失，想去争取，反而会失掉，要再次可成，一定要做到第二次。"
      ],
      "liunian": [
        "如果流年逢到的时候，流年卦最重要。",
        "第一个。二人同力，所求初不成，再次吉，就是第二次才成。",
        "第二个，官事，当官的人，不升，财禄呢，天机道就是不求反吉，越不求财，财就进来，不求反吉。损卦完了好，诸位看下面那副卦。"
      ]
    }
  },
  "history": [
    {
      "source": "",
      "dynasty": "",
      "description": "此卦薛仁貴將收燕,卜得之,大破燕軍。"
    }
  ],
  "lines": [
    {
      "attribute": "初九",
      "scripture": "已事遄往，无咎；酌损之。",
      "xiang": "“已事遄往”，尚合志也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "利贞，征凶；弗损益之。",
      "xiang": "九二“利贞”，中以为志也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "三人行，则损一人；一人行，则得其友。",
      "xiang": "“一人行”，三则疑也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "损其疾，使遄有喜，无咎。",
      "xiang": "“损其疾”，亦可喜也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "或益之十朋之龟，弗克违，元吉。",
      "xiang": "六五“元吉”，自上祐也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "弗损益之，无咎。贞吉，利有攸往，得臣无家。",
      "xiang": "“弗损益之”，大得志也。",
      "nishi": "（待补充）"
    }
  ]
}
