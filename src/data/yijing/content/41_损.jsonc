  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "已事遄往，无咎；酌损之。",
      "xiang": "“已事遄往”，尚合志也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "利贞，征凶；弗损益之。",
      "xiang": "九二“利贞”，中以为志也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "三人行，则损一人；一人行，则得其友。",
      "xiang": "“一人行”，三则疑也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "损其疾，使遄有喜，无咎。",
      "xiang": "“损其疾”，亦可喜也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "或益之十朋之龟，弗克违，元吉。",
      "xiang": "六五“元吉”，自上祐也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "弗损益之，无咎。贞吉，利有攸往，得臣无家。",
      "xiang": "“弗损益之”，大得志也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
