  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "往蹇，来誉。",
      "xiang": "“往蹇，来誉”，宜待也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "王臣蹇蹇，匪躬之故。",
      "xiang": "“王臣蹇蹇”，终无尤也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "往蹇，来反。",
      "xiang": "“往蹇，来反”，内喜之也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "往蹇，来连。",
      "xiang": "“往蹇，来连”，当位实也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "大蹇，朋来。",
      "xiang": "“大蹇，朋来”，以中节也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "往蹇，来硕；吉，利见大人。",
      "xiang": "“往蹇，来硕”，志在内也；“利见大人”，以从贵也。",
      "nishi": "（待补充）"
    }
  ],
