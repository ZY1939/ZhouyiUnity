  "id": 39,
  "name": "蹇",
  "full_name": "水山蹇",
  "symbol": "䷦",
  "binary": "001010",
  "upper": "坎",
  "lower": "艮",
  "scripture": "利西南，不利东北；利见大人，贞吉。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "蹇，难也，险在前也；见险而能止，知矣哉！“蹇，利西南”，往得中也；“不利东北”，其道穷也。“利见大人”，往有功也；当位“贞吉”，以正邦也。蹇之时用大矣哉！",
  "daxiang": "山上有水，蹇。君子以反身修德。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 64,
  "huguaName": "火水未济",

  // ═════════════════════════════════════════════
