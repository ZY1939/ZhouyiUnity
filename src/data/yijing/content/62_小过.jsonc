  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "飞鸟以凶。",
      "xiang": "“飞鸟以凶”，不可如何也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "过其祖，遇其妣；不及其君，遇其臣，无咎。",
      "xiang": "“不及其君”，臣不可过也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "弗过防之，从或戕之，凶。",
      "xiang": "“从或戕之”，凶如何也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "无咎，弗过遇之；往厉必戒，勿用永贞。",
      "xiang": "“弗过遇之”，位不当也；“往厉必戒”，终不可长也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "密云不雨，自我西郊；公弋取彼在穴。",
      "xiang": "“密云不雨”，已上也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "弗遇过之；飞鸟离之，凶，是谓灾眚。",
      "xiang": "“弗遇过之”，已亢也。",
      "nishi": "（待补充）"
    }
  ],
