  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "无妄，往吉。",
      "xiang": "“无妄”之“往”，得志也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "不耕获，不菑畬，则利有攸往。",
      "xiang": "“不耕获”，未富也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "无妄之灾：或系之牛，行人之得，邑人之灾。",
      "xiang": "“行人”得牛，“邑人”灾也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "可贞，无咎。",
      "xiang": "“可贞，无咎”，固有之也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "无妄之疾，勿药有喜。",
      "xiang": "“无妄”之“药”，不可试也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "无妄，行有眚，无攸利。",
      "xiang": "“无妄”之“行”，穷之灾也。",
      "nishi": "（待补充）"
    }
  ],
