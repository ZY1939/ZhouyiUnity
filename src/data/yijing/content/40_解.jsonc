  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "无咎。",
      "xiang": "刚柔之际，义“无咎”也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "田获三狐，得黄矢；贞吉。",
      "xiang": "九二“贞吉”，得中道也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "负且乘，致寇至，贞吝。",
      "xiang": "“负且乘”，亦可丑也；自我致戎，又谁咎也？",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "解而拇，朋至斯孚。",
      "xiang": "“解而拇”，未当位也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "君子维有解，吉，有孚于小人。",
      "xiang": "“君子”“有解”，小人退也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "公用射隼于高墉之上，获之，无不利。",
      "xiang": "“公用射隼”，以解悖也。",
      "nishi": "（待补充）"
    }
  ],
