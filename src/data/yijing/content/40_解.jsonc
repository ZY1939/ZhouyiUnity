  "id": 40,
  "name": "解",
  "full_name": "雷水解",
  "fullName_tc": "雷水解",
  "symbol": "䷧",
  "binary": "010100",
  "upper": "震",
  "lower": "坎",
  "scripture": "利西南。无所往，其来复吉。有攸往，夙吉。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "解，险以动，动而免乎险，解。“解，利西南”，往得众也；“其来复吉”，乃得中也；“有攸往，夙吉”，往有功也。天地解而雷雨作，雷雨作而百果草木皆甲坼。解之时义大矣哉！",
  "daxiang": "雷雨作，解。君子以赦过宥罪。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 63,
  "huguaName": "水火既济",

  // ═════════════════════════════════════════════
  //  象课
  // ═════════════════════════════════════════════
  "xiang_ke": {
    "xiang": "雷行風止之課",
    "ke": "患難解散之象"
  },

  // ═════════════════════════════════════════════
  //  倪师卦解、占卜、阳宅、批八字
  // ═════════════════════════════════════════════
  "nishi": {
    "interpretation": "解者散也,萬物無終難之理,難至極而散,故解為蹇之序。此卦震上坎下,外動內險,即 動於險外,有出險之象,故為患難解散之時也。\n",
    "diagram": {
      "description": [
        "一、旗上提字:指名提凶,不利。有遠走他鄉之象。",
        "二、一刀插地:求快也,劉姓之人也。",
        "三、一兔走:卯年,劉姓。",
        "四、一雞在邊鳴:有競爭象,酉年適逢貴人救。",
        "五、貴人雲中:不及救也。",
        "六、道士手指門:入空門也,逃亡方向,出家也。",
        "七、道人獻書:裝飾外表,示誠象。"
      ],
      "image_path": "",
      "content": "旗上提字,一刀插地,一兔走,貴 旗上提字,一刀插地,一兔走,貴旗上提字,一刀插地,一兔走,貴 旗上提字,一刀插地,一兔走,貴 人雲中,一雞在邊鳴,道士手指門,道 人雲中,一雞在邊鳴,道士手指門,道人雲中,一雞在邊鳴,道士手指門,道 人雲中,一雞在邊鳴,道士手指門,道 人獻書,小堠在側。 人獻書,小堠在側。人獻書,小堠在側。人獻書,小堠在側。"
    },
    "home": {
      "member": "长男",
      "direction": "北",
      "description": []
    },
    "heluo": {
      "xiantian": [
        "解卦出现的时候，逢到先天卦，先天卦逢到。",
        "第一个，生於患难，生於患难时，后平安。",
        "第二个，逢兔啊，而走，失一兄，去了一个哥哥。",
        "第三个，去武从文，数中定。",
        "第四个，逢鸡啊，则主入空门。",
        "第五个，正官带印，如果刚好是卯金，立刀人， 大吉，正官带印，雷水解的时候，所以雷水解发刘（劉）人，姓刘的。"
      ],
      "houtian": [
        "后天卦逢到雷水解的时候很好玩，为什么呢?",
        "第一个，大志，胸有大志，磨了半天磨掉了，消磨了，日沉沉。",
        "第二个，难舍众生一兔人。",
        "第三个，后天卦逢到的时候，逢鸡，逢到鸡出现的时候，就有机了，逢鸡有机，可以展长才，一展你的长才。",
        "第四个，日在床头，不需虞，不需要担心。"
      ],
      "liunian": [
        "到了流年卦的时候，流年卦。",
        "是非，这一年逢到雷水解的时候，是非之年，流年有是非。兔人一刀走他乡。走他乡以后，身在逆旅。没想到，逢到鸡，逢到鸡的时候反得利。这个时候日出山头。鸡呢，酉鸡啊，差不多是在九月份的时候，年，一年我们就看月。"
      ]
    }
  },
  "history": [
    {
      "source": "",
      "dynasty": "",
      "description": "此卦項羽受困垓下,卜得之,後果士卒潰散也。"
    }
  ],
  "lines": [
    {
      "attribute": "初六",
      "scripture": "无咎。",
      "xiang": "刚柔之际，义“无咎”也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "田获三狐，得黄矢；贞吉。",
      "xiang": "九二“贞吉”，得中道也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "负且乘，致寇至，贞吝。",
      "xiang": "“负且乘”，亦可丑也；自我致戎，又谁咎也？",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "解而拇，朋至斯孚。",
      "xiang": "“解而拇”，未当位也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "君子维有解，吉，有孚于小人。",
      "xiang": "“君子”“有解”，小人退也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "公用射隼于高墉之上，获之，无不利。",
      "xiang": "“公用射隼”，以解悖也。",
      "nishi": "（待补充）"
    }
  ]
}
