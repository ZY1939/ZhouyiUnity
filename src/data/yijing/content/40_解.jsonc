  // ═════════════════════════════════════════════
  //  倪师卦解、占卜、阳宅、批八字
  // ═════════════════════════════════════════════
  "nishi": {
    "interpretation": "",
    "diagram": {
      "description": [
        "一、旗上提字:指名提凶,不利。有遠走他鄉之象。",
        "二、一刀插地:求快也,劉姓之人也。",
        "三、一兔走:卯年,劉姓。",
        "四、一雞在邊鳴:有競爭象,酉年適逢貴人救。",
        "五、貴人雲中:不及救也。",
        "六、道士手指門:入空門也,逃亡方向,出家也。",
        "七、道人獻書:裝飾外表,示誠象。"
      ],
      "image_path": ""
    },
