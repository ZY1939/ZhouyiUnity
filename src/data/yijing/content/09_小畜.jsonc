  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "复自道，何其咎？吉。",
      "xiang": "“复自道”，其义“吉”也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "牵复，吉。",
      "xiang": "“牵复”在中，亦不自失也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "舆说辐，夫妻反目。",
      "xiang": "“夫妻反目”，不能正室也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "有孚，血去惕出，无咎。",
      "xiang": "“有孚”“惕出”，上合志也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "有孚挛如，富以其邻。",
      "xiang": "“有孚挛如”，不独富也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "既雨既处，尚德载；妇贞厉，月几望；君子征凶。",
      "xiang": "“既雨既处”，“德”积“载”也。“君子征凶”，有所疑也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
