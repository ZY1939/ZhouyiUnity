  "upper": "巽",
  "lower": "乾",
  "scripture": "亨。密云不雨，自我西郊。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "“小畜”，柔得位而上下应之，曰小畜。健而巽，刚中而志行，乃“亨”。“密云不雨”，尚往也；“自我西郊”，施未行也。",
  "daxiang": "风行天上，小畜。君子以懿文德。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 38,
  "huguaName": "火泽睽",

