  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "晋如摧如，贞吉。罔孚，裕无咎。",
      "xiang": "“晋中摧如”，独行正也。“裕无咎”，未受命也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "晋如愁如，贞吉，受兹介福，于其王母。",
      "xiang": "“受兹介福”，以中正也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "众允，悔亡。",
      "xiang": "“众允”之志，上行也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "晋如鼫鼠，贞厉。",
      "xiang": "“鼫鼠”“贞厉”，位不当也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "悔亡，失得勿恤，往吉，无不利。",
      "xiang": "“失得勿恤”，往有庆也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "晋其角，维用伐邑，厉吉无咎。贞吝。",
      "xiang": "“维用伐邑”，道未光也。",
      "nishi": "（待补充）"
    }
  ],
