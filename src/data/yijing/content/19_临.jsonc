  "id": 19,
  "name": "临",
  "full_name": "地泽临",
  "symbol": "䷒",
  "binary": "110000",
  "upper": "坤",
  "lower": "兑",
  "scripture": "元亨，利贞；至于八月，有凶。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "临，刚浸而长，说而顺，刚中而应。大“亨”以正，天之道也。“至于八月，有凶”，消不久也。",
  "daxiang": "泽上有地，临。君子以教思无穷，容保民无疆。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 24,
  "huguaName": "地雷复",

