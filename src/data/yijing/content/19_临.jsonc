  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "咸临，贞吉。",
      "xiang": "“咸临，贞吉”，志行正也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "咸临，吉，无不利。",
      "xiang": "“咸临，吉，无不利”，未顺命也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "甘临，无攸利；既忧之，无咎。",
      "xiang": "“甘临”，位不当也；“既忧之”，“咎”不长也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "至临，无咎。",
      "xiang": "“至临，无咎”，位当也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "知临，大君之宜，吉。",
      "xiang": "“大君之宜”，行中之谓也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "敦临，吉，无咎。",
      "xiang": "“敦临”之“吉”，志在内也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
  },
  "{path}": ["一、婦人乘風:外援為陰女,美人也。", "二、一車上有使旗:出使之象,以謀略可解災,謀之對象為女人也。連姓、車 姓人。", "三、人在山頂頭:盛極將衰,招困也,即將下坡也。", "四、虎在山下坐:人受虎困之象。", "五、一合:先成後破象。", "六、人射弓:張姓人士,夷狄之人,以弓射獵,故外族入侵象。"]
