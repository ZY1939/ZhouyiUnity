  //  倪师卦解、占卜、阳宅、批八字
  // ═════════════════════════════════════════════
  "nishi": {
    "interpretation": "",
    "diagram": {
      "description": [
        "一、婦人乘風:外援為陰女,美人也。",
        "二、一車上有使旗:出使之象,以謀略可解災,謀之對象為女人也。連姓、車 姓人。",
        "三、人在山頂頭:盛極將衰,招困也,即將下坡也。",
        "四、虎在山下坐:人受虎困之象。",
        "五、一合:先成後破象。",
        "六、人射弓:張姓人士,夷狄之人,以弓射獵,故外族入侵象。"
      ],
      "image_path": ""
    },
    "home": {
      "member": "母亲",
      "direction": "西",
      "description": []
    },
