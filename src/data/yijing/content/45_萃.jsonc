  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "有孚不终，乃乱乃萃；若号，一握为笑，勿恤，往无咎。",
      "xiang": "“乃乱乃萃”，其志乱也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "引吉，无咎；孚乃利用禴。",
      "xiang": "“引吉，无咎”，中未变也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "萃如，嗟如，无攸利；往无咎，小吝。",
      "xiang": "“往无咎”，上巽也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "大吉，无咎。",
      "xiang": "“大吉，无咎”，位不当也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "萃有位，无咎；匪孚，元永贞，悔亡。",
      "xiang": "“萃有位”，志未光也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "赍咨涕洟，无咎。",
      "xiang": "“赍咨涕洟”，未安上也。",
      "nishi": "（待补充）"
    }
  ],
