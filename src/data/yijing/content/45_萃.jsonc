  "id": 45,
  "name": "萃",
  "full_name": "泽地萃",
  "symbol": "䷬",
  "binary": "000110",
  "upper": "兑",
  "lower": "坤",
  "scripture": "亨，王假有庙，利见大人，亨，利贞；用大牲吉，利有攸往。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "萃，聚也；顺以说，刚中而应，故聚也。“王假有庙”，致孝享也；“利见大人，亨”，聚以正也；“用大牲吉，利有攸往”，顺天命也。观其所聚，而天地万物之情可见矣。",
  "daxiang": "泽上于地，萃。君子以除戎器，戒不虞。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 53,
  "huguaName": "风山渐",

  // ═════════════════════════════════════════════
  //  象课
