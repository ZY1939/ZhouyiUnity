  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "旅琐琐，斯其所取灾。",
      "xiang": "“旅琐琐”，志穷灾也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "旅即次，怀其资，得童仆，贞。",
      "xiang": "“得童仆，贞”，终无尤也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "旅焚其次，丧其童仆，贞厉。",
      "xiang": "“旅焚其次”，亦以伤矣；以旅与下，其义“丧”也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "旅于处，得其资斧，我心不快。",
      "xiang": "“旅于处”，未得位也；“得其资斧”，心未快也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "射雉，一矢亡；终以誉命。",
      "xiang": "“终以誉命”，上逮也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "鸟焚其巢，旅人先笑后号啕；丧牛于易，凶。",
      "xiang": "以旅在上，其义“焚”也；“丧牛于易”，终莫之闻也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
  },
  "{path}": ["一、三星者:三台貴人,相位之人。", "二、貴人台上垂釣:君主相求,老闆相求人才。", "三、牽水畔人:賢能之人,離野入朝封候。或慕權勢而變志。", "四、一猴一羊:肖猴,肖羊,候、楊姓人,未申年應之。", "五、大溪:脱險也,港口也,水側也。"]
