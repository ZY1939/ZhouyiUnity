  "id": 56,
  "name": "旅",
  "full_name": "火山旅",
  "symbol": "䷷",
  "binary": "001101",
  "upper": "离",
  "lower": "艮",
  "scripture": "小亨，旅贞吉。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "“旅，小亨”，柔得中乎外而顺乎刚，止而丽乎明，是以“小亨，旅贞吉”也。旅之时义大矣哉！",
  "daxiang": "山上有火，旅。君子以明慎用刑而不留狱。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 28,
  "huguaName": "泽风大过",

  // ═════════════════════════════════════════════
  //  象课
  // ═════════════════════════════════════════════
  "xiang_ke": {
    "xiang": "（待补充）",
    "ke": "（待补充）"
  },

  // ═════════════════════════════════════════════
  //  倪师卦解、占卜、阳宅、批八字
  // ═════════════════════════════════════════════
  "nishi": {
    "interpretation": "",
    "diagram": {
      "description": [
        "一、三星者:三台貴人,相位之人。",
        "二、貴人台上垂釣:君主相求,老闆相求人才。",
        "三、牽水畔人:賢能之人,離野入朝封候。或慕權勢而變志。",
        "四、一猴一羊:肖猴,肖羊,候、楊姓人,未申年應之。",
        "五、大溪:脱險也,港口也,水側也。"
      ],
      "image_path": ""
    },
