  "nishi": {
    "interpretation": "",
    "diagram": {
      "description": [
        "一、山上有寺:出家狀,對峙狀,寸土寸金象。",
        "二、僧:化外之人,光頭人,曾姓人。",
        "三、一人隨後:逃避,求助化外之人。",
        "四、一鬼在後:為禍追緝之象,內心有鬼,處事不明象。",
        "五、金甲人:正義之師,得民心也。",
        "六、寺,土頭人作對。等待時機也。"
      ],
      "image_path": ""
    },
