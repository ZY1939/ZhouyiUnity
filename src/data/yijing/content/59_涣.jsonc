  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "用拯马壮，吉。",
      "xiang": "初六之“吉”，顺也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "涣奔其机，悔亡。",
      "xiang": "“涣奔其机”，得愿也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "涣其躬，无悔。",
      "xiang": "“涣其躬”，志在外也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "涣其群，元吉；涣有丘，匪夷所思。",
      "xiang": "“涣其群，元吉”，光大也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "涣汗其大号，涣王居，无咎。",
      "xiang": "“王居”“无咎”，正位也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "涣其血去逖出，无咎。",
      "xiang": "“涣其血”，远害也。",
      "nishi": "（待补充）"
    }
  ],
