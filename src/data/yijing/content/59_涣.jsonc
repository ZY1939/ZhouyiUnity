  "id": 59,
  "name": "涣",
  "full_name": "风水涣",
  "symbol": "䷺",
  "binary": "010011",
  "upper": "巽",
  "lower": "坎",
  "scripture": "亨，王假有庙，利涉大川，利贞。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "“涣，亨”，刚来而不穷，柔得位乎外而上同。“王假有庙”，王乃在中也。“利涉大川”，乘木有功也。",
  "daxiang": "风行水上，涣。先王以享于帝，立庙。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 27,
  "huguaName": "山雷颐",

