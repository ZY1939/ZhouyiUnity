  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "浚恒，贞凶，无攸利。",
      "xiang": "“浚恒”之“凶”，始求深也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "悔亡。",
      "xiang": "九二“悔亡”，能久中也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "不恒其德，或承之羞；贞吝。",
      "xiang": "“不恒其德”，无所容也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "田无禽。",
      "xiang": "久非其位，安得禽也？",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "恒其德，贞；妇人吉，夫子凶。",
      "xiang": "“妇人”贞吉，从一而终也。“夫子”制义，从妇凶也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "振恒，凶。",
      "xiang": "“振恒”在上，大无功也。",
      "nishi": "（待补充）"
    }
  ],
