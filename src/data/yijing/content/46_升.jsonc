  "id": 46,
  "name": "升",
  "full_name": "地风升",
  "symbol": "䷭",
  "binary": "011000",
  "upper": "坤",
  "lower": "巽",
  "scripture": "元亨，用见大人，勿恤。南征吉。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "柔以时升，巽而顺，刚中而应，是以大亨。“用见大人，勿恤”，有庆也；“南征吉”，志行也。",
  "daxiang": "地中生木，升。君子以顺德，积小以高大。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 54,
  "huguaName": "雷泽归妹",

