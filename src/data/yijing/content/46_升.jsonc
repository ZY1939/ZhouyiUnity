  "lines": [
    {
      "attribute": "初六",
      "scripture": "允升，大吉。",
      "xiang": "“允升，大吉”，上合志也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "孚乃利用禴，无咎。",
      "xiang": "九二之“孚”，有喜也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "升虚邑。",
      "xiang": "“升虚邑”，无所疑也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "王用亨于岐山，吉无咎。",
      "xiang": "“王用亨于岐山”，顺事也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "贞吉，升阶。",
      "xiang": "“贞吉，升阶”，大得志也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "冥升，利于不息之贞。",
      "xiang": "“冥升在上”，消不富也。",
      "nishi": "（待补充）"
    }
  ],
