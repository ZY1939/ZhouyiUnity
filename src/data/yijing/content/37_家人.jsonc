  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "闲有家，悔亡。",
      "xiang": "“闲有家”，志未变也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "无攸遂，在中馈，贞吉。",
      "xiang": "六二之“吉”，顺以巽也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "家人嗃嗃，悔厉，吉；妇子嘻嘻，终吝。",
      "xiang": "“家人嗃嗃”，未失也；“妇子嘻嘻”，失家节也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "富家，大吉。",
      "xiang": "“富家，大吉”，顺在位也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "王假有家，勿恤，吉。",
      "xiang": "“王假有家”，交相爱也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "有孚，威如，终吉。",
      "xiang": "“威如”之“吉”，反身之谓也。",
      "nishi": "（待补充）"
    }
  ],
