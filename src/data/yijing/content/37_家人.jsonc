  "nishi": {
    "interpretation": "",
    "diagram": {
      "description": [
        "一、一人張弓:暗算,破壞也。",
        "二、一帶在水邊:事滯也,棄官也。",
        "三、雲中文書:突而來之喜訊也。",
        "四、貴人拜受:綬命也。",
        "五、婦人攜手:家和之象,此卦卜婚姻大吉。"
      ],
      "image_path": ""
    },
    "home": {
      "member": "长女",
      "direction": "南",
      "description": []
