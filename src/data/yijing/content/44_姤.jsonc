  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "系于金柅，贞吉；有攸往，见凶，羸豕孚踯躅。",
      "xiang": "“系于金柅”，柔道牵也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "包有鱼，无咎，不利宾。",
      "xiang": "“包有鱼”，义不及宾也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "臀无肤，其行次且；厉，无大咎。",
      "xiang": "“其行次且”，行未牵也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "包无鱼，起凶。",
      "xiang": "“无鱼”之“凶”，远民也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "以杞包瓜，含章，有陨自天。",
      "xiang": "九五“含章”，中正也；“有陨自天”，志不舍命也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "姤其角，吝，无咎。",
      "xiang": "“姤其角”，上穷吝也。",
      "nishi": "（待补充）"
    }
  ],
