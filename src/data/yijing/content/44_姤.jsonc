  "id": 44,
  "name": "姤",
  "full_name": "天风姤",
  "symbol": "䷫",
  "binary": "011111",
  "upper": "乾",
  "lower": "巽",
  "scripture": "女壮，勿用取女。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "姤，遇也，柔遇刚也。“勿用取女”，不可与长也。天地相遇，品物咸章也。刚遇中正，天下大行也。姤之时义大矣哉！",
  "daxiang": "天下有风，姤。后以施命诰四方。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 1,
  "huguaName": "乾为天",

  // ═════════════════════════════════════════════
  //  象课
  // ═════════════════════════════════════════════
  "xiang_ke": {
    "xiang": "（待补充）",
