  // ═════════════════════════════════════════════
  "id": 44,
  "name": "姤",
  "full_name": "天风姤",
  "fullName_tc": "天風姤",
  "symbol": "䷫",
  "binary": "011111",
  "upper": "乾",
  "lower": "巽",
  "scripture": "女壮，勿用取女。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "姤，遇也，柔遇刚也。“勿用取女”，不可与长也。天地相遇，品物咸章也。刚遇中正，天下大行也。姤之时义大矣哉！",
  "daxiang": "天下有风，姤。后以施命诰四方。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 1,
  "huguaName": "乾为天",

  // ═════════════════════════════════════════════
  //  象课
  // ═════════════════════════════════════════════
  "xiang_ke": {
    "xiang": "風雲相濟之課",
    "ke": "或聚或散之象"
  },

  // ═════════════════════════════════════════════
  //  倪师卦解、占卜、阳宅、批八字
  // ═════════════════════════════════════════════
  "nishi": {
    "interpretation": "夬,決也,潰決之後,必有遇,姤,遇也,故次夬卦。此卦,乾上巽下,即風行天下,風 行時必觸及萬物,故為遇之象。\n",
    "diagram": {
      "description": [
        "一、官人射鹿:丈夫也,取祿狀,野外之財,射,發也。",
        "二、文書上有喜字:摇摇欲墜,根只一線,夫妻凶。",
        "三、二人執索:互相牽累。",
        "四、綠衣人指路:掌生死簿之人,信差(今日)。",
        "五、二重山:重阻也。出也。"
      ],
      "image_path": "",
      "content": "# 天風姤"
    },
    "home": {
      "member": "父亲",
      "direction": "东南",
      "description": []
    },
    "heluo": {
      "xiantian": [
        "遇到姤卦的时候，他的先天卦。",
        "第一个，也是一样，外柔内刚， 男人呢， 主一妻又一妻，女人逢到了，主一夫又一夫。",
        "第二个，身短才高。这种先天卦，财官双美。",
        "第三个，唯一的缺点呢，唯有婚姻如线，意思就是说婚姻很容易断掉。",
        "第四个，数中呢，有四个人，一个兄弟外出， 两个兄弟在做官，一个兄弟有凶事，这个是他是数。"
      ],
      "houtian": [
        "后天卦呢，你如果是姤卦。",
        "第一个，终身忙碌，然后夫妻同床异梦。挑拨你啊，李登辉和他太太做的梦，同床异梦。他太太在做梦多少人送珠宝给她，他在梦政权如何转移。两个是同床异梦。",
        "第二个，然后数上面写的，侥幸得财，就是运气很好，侥幸得财，却防官累，所以诸位呢得财千万不要有侥幸的心理。",
        "第三个，合伙有事，不宜，合伙不是很好。"
      ],
      "liunian": [
        "如果流年逢到值年卦，那那一年刚好是姤卦的时候。",
        "第一个，主得意外财，意外之财，你从来没有想到会赚到这笔钱，突然跑进来。",
        "第二个，婚事遇到这种卦的时候，易成，你可能还没开口的时候，对方就已经表示我要嫁给你了。",
        "第三个，这一年什么事情都是完全是侥幸。",
        "第四个，有外出， 出行大利，比如说到国外去， 出行大利。",
        "第五个，大头贵人，小头事凶。小头会有凶事。",
        "第六个，科甲吉。这一年如果考试的话，非常的好，考试非常好。"
      ]
    }
  },
  "history": [
    {
      "source": "",
      "dynasty": "",
      "description": "此卦漢呂后擬立呂氏謀漢社稷,卜得之果 不利也。"
    }
  ],
  "lines": [
    {
      "attribute": "初六",
      "scripture": "系于金柅，贞吉；有攸往，见凶，羸豕孚踯躅。",
      "xiang": "“系于金柅”，柔道牵也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "包有鱼，无咎，不利宾。",
      "xiang": "“包有鱼”，义不及宾也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "臀无肤，其行次且；厉，无大咎。",
      "xiang": "“其行次且”，行未牵也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "包无鱼，起凶。",
      "xiang": "“无鱼”之“凶”，远民也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "以杞包瓜，含章，有陨自天。",
      "xiang": "九五“含章”，中正也；“有陨自天”，志不舍命也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "姤其角，吝，无咎。",
      "xiang": "“姤其角”，上穷吝也。",
      "nishi": "（待补充）"
    }
  ]
}
