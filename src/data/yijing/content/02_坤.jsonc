  "id": 2,
  "name": "坤",
  "full_name": "坤为地",
  "symbol": "䷁",
  "binary": "000000",
  "upper": "坤",
  "lower": "坤",
  "scripture": "元亨，利牝马之贞。君子有攸往，先迷，后得主，利。西南得朋，东北丧朋。安贞吉。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "至哉坤元，万物资生，乃顺承天。坤厚载物，德合无疆；含弘光大，品物咸亨。“牝马”地类，行地无疆。柔顺利贞，君子攸行。先迷失道，后顺得常。“西南得朋”，乃与类行；“东北丧朋”，乃终有庆。安贞之吉，应地无疆。",
  "daxiang": "地势坤，君子以厚德载物。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 2,
  "huguaName": "坤为地",

