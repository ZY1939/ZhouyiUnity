  "id": 26,
  "name": "大畜",
  "full_name": "山天大畜",
  "symbol": "䷙",
  "binary": "111001",
  "upper": "艮",
  "lower": "乾",
  "scripture": "利贞，不家食，吉；利涉大川。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "大畜，刚健笃实辉光，日新其德；刚上而尚贤，能止健，大正也。“不家食，吉”，养贤也。“利涉大川”，应乎天也。",
  "daxiang": "天在山中，大畜。君子以多识前言往行，以畜其德。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 54,
  "huguaName": "雷泽归妹",

