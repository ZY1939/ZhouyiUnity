  "lines": [
    {
      "attribute": "初九",
      "scripture": "有厉，利已。",
      "xiang": "“有厉，利已”，不犯灾也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "舆说輹。",
      "xiang": "“舆说輹”，中无尤也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "良马逐，利艰贞。曰闲舆卫，利有攸往。",
      "xiang": "“利有攸往”，上合志也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "童牛之牿，元吉。",
      "xiang": "六四“元吉”，有喜也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "豮豕之牙，吉。",
      "xiang": "六五之“吉”，有庆也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "何天之衢，亨。",
      "xiang": "“何天之衢”，道大行也。",
      "nishi": "（待补充）"
    }
  ],
