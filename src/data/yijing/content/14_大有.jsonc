  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "无交害，匪咎；艰则无咎。",
      "xiang": "大有初九，“无交害”也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "大车以载，有攸往，无咎。",
      "xiang": "“大车以载”，积中不败也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "公用亨于天子，小人弗克。",
      "xiang": "“公用亨于天子”，小人害也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "匪其彭，无咎。",
      "xiang": "“匪其彭，无咎”，明辨晢也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "厥孚交如，威如，吉。",
      "xiang": "“厥孚交如”，信以发志也；“威如”之吉，易而无备也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "自天祐之，吉无不利。",
      "xiang": "大有上吉，“自天祐”也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
