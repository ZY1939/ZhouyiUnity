  "upper": "离",
  "lower": "乾",
  "scripture": "元亨。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "大有，柔得尊位大中，而上下应之，曰大有。其德刚健而文明，应乎天而时行，是以“元亨”。",
  "daxiang": "火在天上，大有。君子以遏恶扬善，顺天休命。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 43,
  "huguaName": "泽天夬",

