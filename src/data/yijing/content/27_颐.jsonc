  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "舍尔灵龟，观我朵颐，凶。",
      "xiang": "“观我朵颐”，亦不足贵也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "颠颐；拂经于丘颐，征凶。",
      "xiang": "六二“征凶”，行失类也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "拂颐；贞凶，十年勿用；无攸利。",
      "xiang": "“十年勿用”，道大悖也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "颠颐，吉；虎视眈眈，其欲逐逐，无咎。",
      "xiang": "“颠颐”之“吉”，上施光也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "拂经；居贞吉，不可涉大川。",
      "xiang": "“居贞”之“吉”，顺以从上也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "由颐；厉吉，利涉大川。",
      "xiang": "“由颐，厉吉”，大有庆也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
