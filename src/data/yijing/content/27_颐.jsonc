  "nishi": {
    "interpretation": "",
    "diagram": {
      "description": [
        "一、雨下:受恩澤也。",
        "二、三小兒:乃合心之象,有德之國也。",
        "三、日當天:君明之象。父全。",
        "四、香案:求取之象。",
        "五、金紫官人:天子身側之人。",
        "六、引一人:提攜,推薦也。"
      ],
      "image_path": ""
    },
