  "id": 50,
  "name": "鼎",
  "full_name": "火风鼎",
  "symbol": "䷱",
  "binary": "011101",
  "upper": "离",
  "lower": "巽",
  "scripture": "元吉，亨。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "鼎，象也。以木巽火，亨饪也。圣人亨以享上帝，而大亨以养圣贤。巽而耳目聪明，柔进而上行，得中而应乎刚，是以元亨。",
  "daxiang": "木上有火，鼎。君子以正位凝命。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 43,
  "huguaName": "泽天夬",

