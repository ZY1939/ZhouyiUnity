  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "鼎颠趾，利出否；得妾以其子，无咎。",
      "xiang": "“鼎颠趾”，未悖也；“利出否”，以从贵也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "鼎有实，我仇有疾，不我能即，吉。",
      "xiang": "“鼎有实”，慎所之也；“我仇有疾”，终无尤也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "鼎耳革，其行塞。雉膏不食；方雨亏悔，终吉。",
      "xiang": "“鼎耳革”，失其义也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "鼎折足，覆公餗，其形渥，凶。",
      "xiang": "“覆公餗”，信如何也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "鼎黄耳，金铉，利贞。",
      "xiang": "“鼎黄耳”，中以为实也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "鼎玉铉，大吉，无不利。",
      "xiang": "“玉铉”在上，刚柔节也。",
      "nishi": "（待补充）"
    }
  ],
