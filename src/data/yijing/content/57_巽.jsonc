  "upper": "巽",
  "lower": "巽",
  "scripture": "小亨，利有攸往，利见大人。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "重巽以申命。刚巽乎中正而志行，柔皆顺乎刚，是以“小亨，利有攸往，利见大人”。",
  "daxiang": "随风，巽。君子以申命行事。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 38,
  "huguaName": "火泽睽",

