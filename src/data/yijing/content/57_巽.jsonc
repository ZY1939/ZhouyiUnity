  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "进退，利武人之贞。",
      "xiang": "“进退”，志疑也；“利武人之贞”，志治也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "巽在床下，用史巫纷若，吉，无咎。",
      "xiang": "“纷若”之“吉”，得中也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "频巽，吝。",
      "xiang": "“频巽”之“吝”，志穷也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "悔亡，田获三品。",
      "xiang": "“田获三品”，有功也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "贞吉，悔亡，无不利。无初有终。先庚三日，后庚三日，吉。",
      "xiang": "九五之“吉”，位正中也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "巽在床下，丧其资斧，贞凶。",
      "xiang": "“巽在床下”，上穷也；“丧其资斧”，正乎“凶”也。",
      "nishi": "（待补充）"
    }
  ],
