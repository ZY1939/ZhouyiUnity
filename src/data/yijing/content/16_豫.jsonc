  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "鸣豫，凶。",
      "xiang": "初六“鸣豫”，志穷“凶”也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "介于石，不终日，贞吉。",
      "xiang": "“不终日，贞吉”，以中正也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "盱豫，悔。迟有悔。",
      "xiang": "“盱豫”“有悔”，位不当也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "由豫，大有得；勿疑。朋盍簪。",
      "xiang": "“由豫，大有得”，志大行也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "贞疾，恒不死。",
      "xiang": "六五“贞疾”，乘刚也；“恒不死”，中未亡也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "冥豫，成有渝，无咎。",
      "xiang": "“冥豫”在上，何可长也？",
      "nishi": "（待补充）"
    }
  ],
  "": {
