  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "不远复，无祗悔，元吉。",
      "xiang": "“不远”之“复”，以修身也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "休复，吉。",
      "xiang": "“休复”之“吉”，以下仁也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "频复，厉无咎。",
      "xiang": "“频复”之“厉”，义“无咎”也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "中行独复。",
      "xiang": "“中行独复”，以从道也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "敦复，无悔。",
      "xiang": "“敦复，无悔”，中以自考也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "迷复，凶，有灾眚。用行师，终有大败；以其国，君凶，至于十年不克征。",
      "xiang": "“迷复”之“凶”，反君道也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
