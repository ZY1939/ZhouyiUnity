  "id": 24,
  "name": "复",
  "full_name": "地雷复",
  "symbol": "䷗",
  "binary": "100000",
  "upper": "坤",
  "lower": "震",
  "scripture": "亨。出入无疾，朋来无咎。反复其道，七日来复，利有攸往。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "“复，亨”；刚反。动而以顺行，是以“出入无疾，朋来无咎”。“反复其道，七日来复”，天行也。“利有攸往”，刚长也。复，其见天地之心乎？",
  "daxiang": "雷在地中，复。先王以至日闭关，商旅不行，后不省方。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 2,
  "huguaName": "坤为地",

