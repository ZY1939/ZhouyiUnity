      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "栋隆，吉；有它，吝。",
      "xiang": "“栋隆”之“吉”，不桡乎下也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "枯杨生华，老妇得其士夫，无咎无誉。",
