  "id": 28,
  "name": "大过",
  "full_name": "泽风大过",
  "symbol": "䷛",
  "binary": "011110",
  "upper": "兑",
  "lower": "巽",
  "scripture": "栋桡；利有攸往，亨。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "“大过”，大者过也。栋桡，本末弱也。刚过而中，巽而说行，“利有攸往”，乃“亨”。“大过”之时大矣哉！",
  "daxiang": "泽灭木，大过；君子以独立不惧，遁世无闷。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 1,
  "huguaName": "乾为天",

