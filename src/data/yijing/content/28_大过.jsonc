  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "藉用白茅，无咎。",
      "xiang": "“藉用白茅”，柔在下也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "枯杨生稊，老夫得其女妻；无不利。",
      "xiang": "“老夫”“女妻”，过以相与也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "栋桡，凶。",
      "xiang": "“栋桡”之“凶”，不可以有辅也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "栋隆，吉；有它，吝。",
      "xiang": "“栋隆”之“吉”，不桡乎下也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "枯杨生华，老妇得其士夫，无咎无誉。",
      "xiang": "“枯杨生华”，何可久也？“老妇”“士夫”，亦可丑也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "过涉灭顶；凶，无咎。",
      "xiang": "“过涉”之“凶”，不可咎也。",
      "nishi": "（待补充）"
    }
  ],
