  "lines": [
    {
      "attribute": "初六",
      "scripture": "藉用白茅，无咎。",
      "xiang": "“藉用白茅”，柔在下也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "枯杨生稊，老夫得其女妻；无不利。",
