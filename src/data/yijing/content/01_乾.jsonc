  "lines": [
    {
      "attribute": "初九",
      "scripture": "潜龙，勿用。",
      "xiang": "“潜龙，勿用”，阳在下也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "见龙再田，利见大人。",
      "xiang": "“见龙再田”，德施普也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "君子终日乾乾，夕惕若，厉无咎。",
      "xiang": "“终日乾乾”，反复道也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "或跃在渊，无咎。",
      "xiang": "“或跃在渊”，进无咎也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "飞龙在天，利见大人。",
      "xiang": "“飞龙在天”，“大人”造也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "亢龙有悔。",
      "xiang": "“亢龙有悔”，盈不可久也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "用九",
      "scripture": "见群龙无首，吉。",
      "xiang": "“用九”，天德不可为首也。",
