  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "素履，往，无咎。",
      "xiang": "“素履”之“往”，独行愿也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "履道坦坦，幽人贞吉。",
      "xiang": "“幽人贞吉”，中不自乱也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "眇能视，跛能履，履虎尾，咥人，凶；武人为于大君。",
      "xiang": "“眇能视”，不足以有明也；“跛能履”，不足以与行也；“咥人之凶”，位不当也；“武人为于大君”，志刚也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "履虎尾，愬愬，终吉。",
      "xiang": "“愬愬，终吉”，志行也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "夬履，贞厉。",
      "xiang": "“夬履，贞厉”，位正当也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "视履考祥，其旋元吉。",
      "xiang": "元吉在上，大有庆也。",
      "nishi": ""
    }
  ],
  "": {
