  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "壮于趾，征凶，有孚。",
      "xiang": "“壮于趾”，其孚穷也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "贞吉。",
      "xiang": "九二“贞吉”，以中也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "小人用壮，君子用罔；贞厉。羝羊触藩，羸其角。",
      "xiang": "“小人用壮”，“君子”“罔”也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "贞吉，悔亡；藩决不羸，壮于大舆之輹。",
      "xiang": "“藩决不羸”，尚往也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "丧羊于易，无悔。",
      "xiang": "“丧羊于易”，位不当也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "羝羊触藩，不能退，不能遂，无攸利；艰则吉。",
      "xiang": "“不能退，不能遂”，不详也；“艰则吉”，咎不长也。",
      "nishi": "（待补充）"
    }
  ],
