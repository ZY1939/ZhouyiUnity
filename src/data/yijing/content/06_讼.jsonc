  "id": 6,
  "name": "讼",
  "full_name": "天水讼",
  "symbol": "䷅",
  "binary": "010111",
  "upper": "乾",
  "lower": "坎",
  "scripture": "有孚，窒惕，中吉；终凶。利见大人，不利涉大川。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "讼，上刚下险，险而健，讼。“讼：有孚，窒惕，中吉”，刚来而得中也。“终凶”，讼不可成也。“利见大人”，尚中正也。“不利涉大川”，入于渊也。",
  "daxiang": "天与水违行，讼。君子以作事谋始。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 37,
  "huguaName": "风火家人",

