  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "不永所事，小有言，终吉。",
      "xiang": "“不永所事”，讼不可长也；虽“有小言”，其辩明也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "不克讼，归而逋，其邑人三百户，无眚。",
      "xiang": "“不克讼”，归逋，窜也；自下讼上，患至掇也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "食旧德，贞厉，终吉；或从王事，无成。",
      "xiang": "“食旧德”，从上吉也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "不克讼；复即命，渝，安贞，吉。",
      "xiang": "“复即命，渝”，“安贞”不失也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "讼，元吉。",
      "xiang": "“讼，元吉”，以中正也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "或锡之鞶带，终朝三褫之。",
      "xiang": "以讼受服，亦不足敬也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
