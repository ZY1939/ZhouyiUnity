  "id": 38,
  "name": "睽",
  "full_name": "火泽睽",
  "symbol": "䷥",
  "binary": "110101",
  "upper": "离",
  "lower": "兑",
  "scripture": "小事吉。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "睽，火动而上，泽动而下；二女同居，其志不同行；说而丽乎明，柔进而上行，得中而应乎刚，是以“小事吉”。天地睽而其事同也，男女睽而其志通也，万物睽而其事类也；睽之时用大矣哉！",
  "daxiang": "上火下泽，睽；君子以同而异。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 63,
  "huguaName": "水火既济",

