  "nishi": {
    "interpretation": "",
    "diagram": {
      "description": [
        "一、人執斧在手:求快也,行刑之人,執法之人,有權柄也。",
        "二、文書半破:無望象,毁約也。",
        "三、牛鼠:秋冬吉,春夏凶。",
        "四、桃開:逃開也。",
        "五、門掩:牢獄之災,閉也,隔也。",
        "六、雁飛鳴:悲也,孤單也,報凶訊也。"
      ],
      "image_path": ""
    },
