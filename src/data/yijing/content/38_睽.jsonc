  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "悔亡；丧马勿逐，自复；见恶人，无咎。",
      "xiang": "“见恶人”，以辟咎也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "遇主于巷，无咎。",
      "xiang": "“遇主于巷”，未失道也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "见舆曳，其牛掣；其人天且劓。无初有终。",
      "xiang": "“见舆曳”，位不当也。“无初有终”，遇刚也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "睽孤，遇元夫，交孚，厉无咎。",
      "xiang": "“交孚”“无咎”，志行也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "悔亡，厥宗噬肤，往何咎？",
      "xiang": "“厥宗噬肤”，往有庆也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "睽孤，见豕负涂，载鬼一车，先张之弧，后说之弧；匪寇婚媾，往遇雨则吉。",
      "xiang": "“遇雨”之“吉”，群疑亡也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
  },
  "{path}": ["一、人執斧在手:求快也,行刑之人,執法之人,有權柄也。", "二、文書半破:無望象,毁約也。", "三、牛鼠:秋冬吉,春夏凶。", "四、桃開:逃開也。", "五、門掩:牢獄之災,閉也,隔也。", "六、雁飛鳴:悲也,孤單也,報凶訊也。"]
