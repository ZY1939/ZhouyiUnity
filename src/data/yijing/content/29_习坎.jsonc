  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "习坎，入于坎窞，凶。",
      "xiang": "“习坎”入坎，失道凶也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "坎有险，求小得。",
      "xiang": "“求小得”，未出中也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "来之坎坎，险且枕，入于坎窞，勿用。",
      "xiang": "“来之坎坎”，终无功也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "樽酒，簋贰，用缶，纳约自牖，终无咎。",
      "xiang": "“樽酒，簋贰”，刚柔际也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "坎不盈，祗既平，无咎。",
      "xiang": "“坎不盈”，中未大也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "係用徽纆，寘于丛棘，三岁不得，凶。",
      "xiang": "上六失道，凶“三岁”也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
