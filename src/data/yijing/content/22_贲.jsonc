  "id": 22,
  "name": "贲",
  "full_name": "山火贲",
  "symbol": "䷕",
  "binary": "101001",
  "upper": "艮",
  "lower": "离",
  "scripture": "亨，小利有攸往。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "贲，亨；柔来而文刚，故亨。分刚上而文柔，故“小利有攸往”，天文也；文明以止，人文也。观乎天文，以察时变；观乎人文，以化成天下。",
  "daxiang": "山下有火，贲。君子以明庶政，无敢折狱。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 40,
  "huguaName": "雷水解",

