  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "贲其趾，舍车而徒。",
      "xiang": "“舍车而徒”，义弗乘也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "贲其须。",
      "xiang": "“贲其须”，与上兴也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "贲如，濡如，永贞吉。",
      "xiang": "“永贞”之“吉”，终莫之陵也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "贲如，皤如，白马翰如，匪寇，婚媾。",
      "xiang": "六四，当位疑也；“匪寇，婚媾”，终无尤也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "贲于丘园，束帛戋戋；吝，终吉。",
      "xiang": "六五之吉，有喜也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "白贲，无咎。",
      "xiang": "白贲，无咎，上得志也。",
      "nishi": "（待补充）"
    }
  ],
