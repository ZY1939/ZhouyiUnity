  "id": 63,
  "name": "既济",
  "full_name": "水火既济",
  "symbol": "䷾",
  "binary": "101010",
  "upper": "坎",
  "lower": "离",
  "scripture": "亨小，利贞。初吉终乱。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "“既济，亨”，小者亨也。“利贞”，刚柔正而位当也。“初吉”，柔得中也。终止则乱，其道穷也。",
  "daxiang": "水在火上，既济。君子以思患而豫防之。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 64,
  "huguaName": "火水未济",

