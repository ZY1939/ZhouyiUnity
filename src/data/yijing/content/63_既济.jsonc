  "nishi": {
    "interpretation": "",
    "diagram": {
      "description": [
        "一、人在岸上:泣也,等待也,無目的也。",
        "二、一船來:接引至也。",
        "三、一堆錢:財祿無用也,憂心忡忡也,有竊象,抄家之象。",
        "四、雲中雨下:陰中有果也,夜間至凌晨時。",
        "五、二小兒:主喜也,二人也,二人雨中行也。",
        "六、文書一策:證件,命令也,資料也。"
      ],
      "image_path": ""
    },
