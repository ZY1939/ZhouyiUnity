  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "曳其轮，濡其尾，无咎。",
      "xiang": "“曳其轮”，义无咎也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "妇丧其茀，勿逐，七日得。",
      "xiang": "“七日得”，以中道也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "高宗伐鬼方，三年克之；小人勿用。",
      "xiang": "“三年克之”，惫也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "繻有衣袽，终日戒。",
      "xiang": "终日戒，有所疑也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "东邻杀牛，不如西邻之禴祭，实受其福。",
      "xiang": "“东邻杀牛，不如西邻”之时也；“实受其福”，吉大来也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "濡其首，厉。",
      "xiang": "“濡其首，厉”，何可久也！",
      "nishi": "（待补充）"
    }
  ],
