  "nishi": {
    "interpretation": "",
    "diagram": {
      "description": [
        "一、一望竿在爽高處:家人望歸象。",
        "二、 一藥爐在地:平安,無災也。",
        "三、一官人登梯:升官之象,衣錦還鄉也,棺也。",
        "四、一枝花在地:落第象,不久之象。"
      ],
      "image_path": ""
    },
    "home": {
      "member": "长女",
      "direction": "东北",
      "description": []
    },
    "bazi": {
      "young": "",
      "old": "",
      "year": ""
    }
  },
  "history": [
