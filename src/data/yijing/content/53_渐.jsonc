  "id": 53,
  "name": "渐",
  "full_name": "风山渐",
  "symbol": "䷴",
  "binary": "001011",
  "upper": "巽",
  "lower": "艮",
  "scripture": "女归吉，利贞。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "渐之进也，“女归吉”也。进得位，往有功也；进以正，可以正邦也。其位，刚得中也；止而巽，动不穷也。",
  "daxiang": "山上有木，渐。君子以居贤德善俗。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 64,
  "huguaName": "火水未济",

  // ═════════════════════════════════════════════
  //  象课
  // ═════════════════════════════════════════════
  "xiang_ke": {
    "xiang": "（待补充）",
