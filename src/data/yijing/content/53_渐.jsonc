  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "鸿渐于干；小子厉，有言，无咎。",
      "xiang": "“小子”之“厉”，义无咎也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "鸿渐于磐，饮食衎衎，吉。",
      "xiang": "“饮食衎衎”，不素饱也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "鸿渐于陆，夫征不复，妇孕不育，凶；利御寇。",
      "xiang": "“夫征不复”，离群丑也；“妇孕不育”，失其道也；“利”用“御寇”，顺相保也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "鸿渐于木，或得其桷，无咎。",
      "xiang": "“或得其桷”，顺以巽也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "鸿渐于陵，妇三岁不孕；终莫之胜，吉。",
      "xiang": "“终莫之胜，吉”，得所愿也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "鸿渐于陆，其羽可用为仪，吉。",
      "xiang": "“其羽可用为仪，吉”，不可乱也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
  },
  "{path}": ["一、一望竿在爽高處:家人望歸象。", "二、 一藥爐在地:平安,無災也。", "三、一官人登梯:升官之象,衣錦還鄉也,棺也。", "四、一枝花在地:落第象,不久之象。"]
