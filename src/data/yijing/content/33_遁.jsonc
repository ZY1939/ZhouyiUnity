  "id": 33,
  "name": "遁",
  "full_name": "天山遁",
  "symbol": "䷠",
  "binary": "001111",
  "upper": "乾",
  "lower": "艮",
  "scripture": "亨，小利贞。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "“遁，亨”，遁而亨也。刚当位而应，与时行也。“小利贞”，浸而长也。遁之时义大矣哉！",
  "daxiang": "天下有山，遁。君子以远小人，不恶而严。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 44,
  "huguaName": "天风姤",

