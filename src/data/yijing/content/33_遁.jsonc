  ],

  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "遁尾，厉，勿用有攸往。",
      "xiang": "“遁尾”之“厉”，不往，何灾也？",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "执之用黄牛之革，莫之胜说。",
      "xiang": "“执用黄牛”，固志也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "系遁，有疾厉；畜臣妾，吉。",
      "xiang": "“系遁之厉”，有疾惫也；“畜臣妾，吉”，不可大事也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "好遁，君子吉，小人否。",
      "xiang": "“君子”“好遁”，“小人否”也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "嘉遁，贞吉。",
      "xiang": "“嘉遁，贞吉”，以正志也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "肥遁，无不利。",
      "xiang": "“肥遁，无不利”，无所疑也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
  },
  "{path}": ["一、一山:阻也。 二、一水:險也。", "三、酒旗上文字:酒為忘憂之物,文在旗上,受人提攜也。", "四、官人踏龜:歸,鬼也;玄武自來,水上求財。", "五、幞頭上樹:求去辭官也。", "六、月在雲中:主半清半濁象,事未明晰。", "七、人在水邊:等待平安狀,蒞臨也。", "八、樹下人獨酌:休也,無事也,萌生退意狀。"]
