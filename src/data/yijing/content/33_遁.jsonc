  // ═════════════════════════════════════════════
  //  倪师卦解、占卜、阳宅、批八字
  // ═════════════════════════════════════════════
  "nishi": {
    "interpretation": "",
    "diagram": {
      "description": [
        "一、一山:阻也。 二、一水:險也。",
        "三、酒旗上文字:酒為忘憂之物,文在旗上,受人提攜也。",
        "四、官人踏龜:歸,鬼也;玄武自來,水上求財。",
        "五、幞頭上樹:求去辭官也。",
        "六、月在雲中:主半清半濁象,事未明晰。",
        "七、人在水邊:等待平安狀,蒞臨也。",
        "八、樹下人獨酌:休也,無事也,萌生退意狀。"
      ],
      "image_path": ""
    },
    "home": {
      "member": "父亲",
      "direction": "东北",
      "description": []
    },
