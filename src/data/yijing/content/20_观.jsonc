  "lines": [
    {
      "attribute": "初六",
      "scripture": "童观，小人无咎，君子吝。",
      "xiang": "初六“童观”，小人道也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "窥观，利女贞。",
      "xiang": "“窥观”“女贞”，亦可丑也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "观我生，进退。",
      "xiang": "“观我生，进退”，未失道也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "观国之光，利用宾于王。",
      "xiang": "“观国之光”，尚“宾”也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "观我生，君子无咎。",
      "xiang": "“观我生”，观民也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "观其生，君子无咎。",
      "xiang": "“观其生”，志未平也。",
      "nishi": "（待补充）"
    }
  ],
