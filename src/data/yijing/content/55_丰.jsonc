  "id": 55,
  "name": "丰",
  "full_name": "雷火丰",
  "symbol": "䷶",
  "binary": "101100",
  "upper": "震",
  "lower": "离",
  "scripture": "亨，王假之；勿忧，宜日中。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "丰，大也。明以动，故丰。“王假之”，尚大也；“勿忧，宜日中”，宜照天下也。日中则昃，月盈则食；天地盈虚，与时消息，而况人于人乎？况于鬼神乎？",
  "daxiang": "雷电皆至，丰。君子以折狱致刑。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 28,
  "huguaName": "泽风大过",

  // ═════════════════════════════════════════════
  //  象课
  // ═════════════════════════════════════════════
