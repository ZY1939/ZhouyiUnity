  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "归妹以娣，跛能履，征吉。",
      "xiang": "“归妹以娣”，以恒也；“跛能履”“吉”，相承也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "眇能视，利幽人之贞。",
      "xiang": "“利幽人之贞”，未变常也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "归妹以须，反归以娣。",
      "xiang": "“归妹以须”，未当也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "归妹愆期，迟归有时。",
      "xiang": "“愆期”之志，有待而行也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "帝乙归妹，其君之袂，不如其娣之袂良；月几望，吉。",
      "xiang": "“帝乙归妹”，“不如其娣之袂良”也，其位在中，以贵行也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "女承筐，无实；士刲羊，无血。无攸利。",
      "xiang": "上六“无实”，“承”虚“筐”也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
