  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "咸其拇。",
      "xiang": "“咸其拇”，志在外也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "咸其腓，凶；居吉。",
      "xiang": "虽“凶”“居吉”，顺不害也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "咸其股，执其随，往吝。",
      "xiang": "“咸其股”，亦不处也。志在随人，所执下也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "贞吉，悔亡，憧憧往来，朋从尔思。",
      "xiang": "“贞吉，悔亡”，未感害也；“憧憧往来”，未光大也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "咸其脢，无悔。",
      "xiang": "“咸其脢”，志未也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "咸其辅颊舌。",
      "xiang": "“咸其辅颊舌”，滕口说也。",
      "nishi": "（待补充）"
    }
  ],
