  "id": 31,
  "name": "咸",
  "full_name": "泽山咸",
  "fullName_tc": "澤山咸",
  "symbol": "䷞",
  "binary": "001110",
  "upper": "兑",
  "lower": "艮",
  "scripture": "亨，利贞。取女吉。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "咸，感也。柔上而刚下，二气感应以相与。止而说，男下女，是以“亨，利贞。取女吉”也。天地感而万物化生，圣人感人心而天下和平。观其所感，而天地万物之情可见矣！",
  "daxiang": "山上有泽，咸。君子以虚受人。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 44,
  "huguaName": "天风姤",

  // ═════════════════════════════════════════════
  //  象课
  // ═════════════════════════════════════════════
  "xiang_ke": {
    "xiang": "山澤通氣之課",
    "ke": "至誠感神之象"
  },

  // ═════════════════════════════════════════════
  //  倪师卦解、占卜、阳宅、批八字
  // ═════════════════════════════════════════════
  "nishi": {
    "interpretation": "易經上經乃論天地萬物之本,有天地後有萬物,聖人觀其間象,以巨視之角度來體察出天 道。咸卦之始,為易經下經,其論夫婦人倫之始,較重於人道。咸之為卦,兌上艮下,乃少女 少男之意,表示世上男女相感之深,莫過於少男少女,童稚之間無隔閡,人人皆以平常心處之, 男女相悦又無所求,互相以誠及悦相處對應,此時之感,即咸之深意。\n",
    "diagram": {
      "description": [
        "一、空中有一拳:貴人提拔,憑空而得。",
        "二、錢寶一堆:求財得財。",
        "三、貴人在山頂:孤立狀,即將下坡,退休狀。",
        "四、女人上山:夫妻吉,陰人卜之知走馬上任。",
        "五、合子:先成後破,因誠感方吉,物感必凶。"
      ],
      "image_path": "",
      "content": "空中有一拳,錢寶一堆,貴人在山頂, 女人上山,一合子。 女人上山,一合子。女人上山,一合子。"
    },
    "home": {
      "member": "少女",
      "direction": "东北",
      "description": []
    },
    "heluo": {
      "xiantian": [
        "我核对了半天，想了半天，泽山咸，先天卦。",
        "第一个，叫做生既带财来，生下来就会带财，注定继子承家业。",
        "第二个，如果是己年生的，巳年命的人呢，子亦当无，这个儿子会有问题。",
        "第三个，遇到这种卦的时候，这个整个他的命卦，他本身周围的环境呢，财禄日丰，一天比一天好，田园必增，田园呢，一天比一天往上，越增越高。",
        "第四个，遇到午火，火年的时候呢，婚事成，婚事会成功，女有贵夫，男有美妻。"
      ],
      "houtian": [
        "后天卦逢到的时候。",
        "第一个，当官的人，官至呢，官位会到一方之主，一个地方最大的，市长，县长，院长，校长。但是呢，一方之主，但是孤立无援，都是要靠自己，孤立无援。",
        "第二个，妻呢，贤妻，太太非常好，贤妻对你的助力大，但是呢，最好是内助就好了，如果外助的时候，得知反为凶，你太太出来帮你的时候，反而是凶的，太太是很好，但是她做事情反而是凶的。所以有时候我们出发点是善意的，可是有时候你害到人了还不知道。",
        "第三个，如果是女命逢之，女人的命呢，逢到泽山咸后天卦的时候，助夫反害夫，你遇到这个卦，拿起来给那个人看，他太太一看心就碎了，这个卦比较难读。"
      ],
      "liunian": [
        "流年卦，流年卦逢到的时候。",
        "第一个，这个就是我们的孙X了，凭空而得权禄位，空中有一拳，凭空而得权禄位。",
        "第二个，你是商人，做生意的人，商人逢之了，得财。女人呢，升职，女孩子升官。",
        "第三个，如果是官人， 当官的人逢之，须退，要赶快退下来了，否则招凶，官人逢到，当官的人逢到了，流年卦泽山咸的时候，官位一定会这样子，官位到顶，那个人走到山顶了，到顶了，要走下坡，每一个人官位一定会到顶，不然一个人干公务员干到总统去了，对不对，一定有到极限的嘛。"
      ]
    }
  },
  "history": [
    {
      "source": "",
      "dynasty": "",
      "description": "此卦漢王昭君,卜得之,知和番不回也。"
    }
  ],
  "lines": [
    {
      "attribute": "初六",
      "scripture": "咸其拇。",
      "xiang": "“咸其拇”，志在外也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "咸其腓，凶；居吉。",
      "xiang": "虽“凶”“居吉”，顺不害也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "咸其股，执其随，往吝。",
      "xiang": "“咸其股”，亦不处也。志在随人，所执下也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "贞吉，悔亡，憧憧往来，朋从尔思。",
      "xiang": "“贞吉，悔亡”，未感害也；“憧憧往来”，未光大也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "咸其脢，无悔。",
      "xiang": "“咸其脢”，志未也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "咸其辅颊舌。",
      "xiang": "“咸其辅颊舌”，滕口说也。",
      "nishi": "（待补充）"
    }
  ]
}
