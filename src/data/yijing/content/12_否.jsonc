  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "拔茅茹，以其汇，贞吉，亨。",
      "xiang": "“拔茅”“贞吉”，志在君也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "包承，小人吉。大人否，亨。",
      "xiang": "“大人否，亨”，不乱群也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "包羞。",
      "xiang": "“包羞”，位不当也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "有命无咎，畴离祉。",
      "xiang": "“有命无咎”，志行也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "休否，大人吉；其亡其亡，系于苞桑。",
      "xiang": "“大人”之“吉”，位正当也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "倾否，先否后喜。",
      "xiang": "否终则倾，何可长也？",
      "nishi": "（待补充）"
    }
  ],
