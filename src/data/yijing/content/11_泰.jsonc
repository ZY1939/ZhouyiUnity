  "id": 11,
  "name": "泰",
  "full_name": "地天泰",
  "symbol": "䷊",
  "binary": "111000",
  "upper": "坤",
  "lower": "乾",
  "scripture": "小往大来，吉，亨。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "“泰，小往大来，吉，亨”，则是天地交而万物通也，上下交而其志同也。内阳而外阴，内健而外顺，内君子而外小人：君子道长，小人道消也。",
  "daxiang": "天地交，泰。后以财成天地之道，辅相天地之宜，以左右民。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 54,
  "huguaName": "雷泽归妹",

