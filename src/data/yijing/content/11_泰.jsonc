  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "拔茅茹，以其汇，征吉。",
      "xiang": "“拔茅”“征吉”，志在外也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "包荒，用冯河，不遐遗；朋亡，得尚于中行。",
      "xiang": "“包荒”，“得尚于中行”，以光大也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "无平不陂，无往不复；艰贞无咎，勿恤其孚，于食有福。",
      "xiang": "“无往不复”，天地际也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "翩翩，不富，以其邻，不戒以孚。",
      "xiang": "“翩翩，不富”，皆失实也。“不戒以孚”，中心愿也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "帝乙归妹，以祉元吉。",
      "xiang": "“以祉元吉”，中以行愿也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "城复于隍，勿用师，自邑告命，贞吝。",
      "xiang": "“城复于隍”，其命乱也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
