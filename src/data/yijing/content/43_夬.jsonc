  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "壮于前趾，往不胜为咎。",
      "xiang": "“不胜”而“往”，咎也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "惕号，莫夜有戎，勿恤。",
      "xiang": "“有戎”“勿恤”，得中道也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "壮于頄，有凶。君子夬夬独行，遇雨若濡，有愠无咎。",
      "xiang": "“君子夬夬”，终无咎也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "臀无肤，其行次且；牵羊悔亡，闻言不信。",
      "xiang": "“其行次且”，位不当也；“闻言不信”，聪不明也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "苋陆夬夬，中行无咎。",
      "xiang": "“中行无咎”，中未光也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "无号，终有凶。",
      "xiang": "“无号”之“凶”，终不可长也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
