  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "虞吉，有他不燕。",
      "xiang": "初九“虞吉”，志未变也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "鸣鹤在阴，其子和之；我有好爵，吾与尔靡之。",
      "xiang": "“其子和之”，中心愿也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "得敌，或鼓或罢，或泣或歌。",
      "xiang": "“或鼓或罢”，位不当也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "月几望，马匹亡，无咎。",
      "xiang": "“马匹亡”，绝类上也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "有孚挛如，无咎。",
      "xiang": "“有孚挛如”，位正当也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "翰音登于天，贞凶。",
      "xiang": "“翰音登于天”，何可长也！",
      "nishi": "（待补充）"
    }
  ],
