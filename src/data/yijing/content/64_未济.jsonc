  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "濡其尾，吝。",
      "xiang": "“濡其尾”，亦不知极也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "曳其轮，贞吉。",
      "xiang": "九二“贞吉”，中以行正也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "未济，征凶，利涉大川。",
      "xiang": "“未济，征凶”，位不当也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "贞吉，悔亡；震用伐鬼方，三年有赏于大国。",
      "xiang": "“贞吉，悔亡”，志行也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "贞吉，无悔；君子之光，有孚，吉。",
      "xiang": "“君子之光”，其晖“吉”也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "有孚于饮酒；无咎，濡其首，有孚失是。",
      "xiang": "“饮酒”濡首，亦不知节也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
