  "id": 64,
  "name": "未济",
  "full_name": "火水未济",
  "symbol": "䷿",
  "binary": "010101",
  "upper": "离",
  "lower": "坎",
  "scripture": "亨，小狐汔济，濡其尾，无攸利。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "“未济，亨”，柔得中也。“小狐汔济”，未出中也；“濡其尾，无攸利”，不续终也。虽不当位，刚柔应也。",
  "daxiang": "火在水上，未济。君子以慎辨物居方。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 63,
  "huguaName": "水火既济",

