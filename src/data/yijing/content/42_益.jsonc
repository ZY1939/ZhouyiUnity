{
  // ═════════════════════════════════════════════
  //  基本信息
  // ═════════════════════════════════════════════
  "id": 42,
  "name": "益",
  "full_name": "风雷益",
  "fullName_tc": "風雷益",
  "symbol": "䷩",
  "binary": "100011",
  "upper": "巽",
  "lower": "震",
  "scripture": "利有攸往，利涉大川。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "益，损上益下，民说无疆；自上下下，其道大光。“利有攸往”，中正有庆；“利涉大川”，木道乃行。益动而巽，日进无疆。天施地生，其益无方。凡益之道，与时偕行。",
  "daxiang": "风雷，益。君子以见善则迁，有过则改。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 23,
  "huguaName": "山地剥",

  // ═════════════════════════════════════════════
  //  象课
  // ═════════════════════════════════════════════
  "xiang_ke": {
    "xiang": "官人抱合子,一人推車,一鹿一錢。 官人抱合子,一人推車,一鹿一錢。** 鴻鵠遇風之課",
    "ke": "河水溢出之象"
  },

  // ═════════════════════════════════════════════
  //  倪师卦解、占卜、阳宅、批八字
  // ═════════════════════════════════════════════
  "nishi": {
    "interpretation": "損而不己必生益,自古盛,衰,損,益,天理循環,損至極生益,所以繼損也。此卦巽上 震下,風雷二物互相增益,雷受風則迅,風受雷激則烈,互相助威,所以成益象。損上益下, 故為益,前卦乃損下益上故損,以其義而推,吾人可知,民厚則國安。\n",
    "diagram": {
      "description": [
        "一、官人抱合子:倌人,丈夫也,事必先成後破。",
        "二、一人推車:因時而動之象,空坐相請。",
        "三、一鹿一錢:才祿俱備,有回祿之災,財有破損,憂心忡忡。",
        "四、不為財货,不畏時尚之變,明知先成後破,仍走馬上任,以損上益下之道,天下或事業亦能平治。"
      ],
      "image_path": "",
      "content": "官人抱合子,一人推車,一鹿一錢。 官人抱合子,一人推車,一鹿一錢。 鴻鵠遇風之課 河水溢出之象"
    },
    "home": {
      "member": "长女",
      "direction": "东",
      "description": [
        "一、長女之婚事不成，或成後又破。",
        "二、財祿足，有祖業，工作則又過於男性。",
        "三、女身男性，貴人為男人，小人為女子。",
        "四、從官運則吉，切不可貪祿，主兇。"
      ]
    },
    "heluo": {
      "xiantian": [
        "第一个，才禄具备，身在贵门。",
        "第二个，这种人呢，承继祖业，发扬光大，会把祖业还会做的更大。",
        "第三个，数中单传，如果有弟的时候，须防。",
        "第四个，这种风雷益长寿，寿如松柏。"
      ],
      "houtian": [
        "后天卦，下半生走的时候。",
        "第一个，运至时行，无往不利，几乎做什么都好，都成功。",
        "第二个，逢官呢，当官，后天卦是这个的时候逢官，结果是破的，就是告诉大家，不要再当官下去了，求财大利，出来做事情，出来自己开业，求财大利。",
        "第三个，这个卦，后天卦呢，有八个字，似凶，看起来好像是凶的，还吉，其实是吉的，夫妻平安。"
      ],
      "liunian": [
        "如果流年卦逢到益卦的时候。",
        "第一个，时来运转， 求财，求官皆得。",
        "第二个，那这种流年的时候，他常常会逢赌，一定要提醒他，逢赌反凶。遇到这个流年卦，风雷益的时候，只有一条路，可进不可退，退出来大凶。那那一年遇到的时候须防火，防火恶，还有防窃，防窃灾，这两个事情都要注意。这是益卦。"
      ]
    }
  },
  "history": [
    {
      "source": "",
      "dynasty": "",
      "description": "此卦冉伯牛有疾,卜得之,乃知謾師之過也。"
    }
  ],
  "lines": [
    {
      "attribute": "初九",
      "scripture": "利用为大作，元吉，无咎。",
      "xiang": "“元吉，无咎”，下不厚事也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "或益之十朋之龟，弗克违。永贞吉；王用享于帝，吉。",
      "xiang": "“或益之”，自外来也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "益之用凶事，无咎；有孚中行，告公用圭。",
      "xiang": "益“用凶事”，固有之也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "中行，告公从，利用为依迁国。",
      "xiang": "“告公从”，以益志也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "有孚惠心，勿问元吉。有孚惠我德。",
      "xiang": "“有孚惠心”，“勿问”之矣；“惠我德”，大得志也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "莫益之，或击之，立心勿恒，凶。",
      "xiang": "“莫益之”，偏辞也；“或击之”，自外来也。",
      "nishi": "（待补充）"
    }
  ]
}
