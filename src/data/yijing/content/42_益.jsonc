  "id": 42,
  "name": "益",
  "full_name": "风雷益",
  "symbol": "䷩",
  "binary": "100011",
  "upper": "巽",
  "lower": "震",
  "scripture": "利有攸往，利涉大川。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "益，损上益下，民说无疆；自上下下，其道大光。“利有攸往”，中正有庆；“利涉大川”，木道乃行。益动而巽，日进无疆。天施地生，其益无方。凡益之道，与时偕行。",
  "daxiang": "风雷，益。君子以见善则迁，有过则改。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 23,
  "huguaName": "山地剥",

