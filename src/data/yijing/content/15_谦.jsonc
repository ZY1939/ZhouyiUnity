  "id": 15,
  "name": "谦",
  "full_name": "地山谦",
  "symbol": "䷎",
  "binary": "001000",
  "upper": "坤",
  "lower": "艮",
  "scripture": "亨，君子有终。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "“谦，亨”，天道下济而光明，地道卑而上行。天道亏盈而益谦，地道变盈而流谦，鬼神害盈而福谦，人道恶盈而好谦。谦尊而光，卑而不可逾，君子之终也。",
  "daxiang": "地中有山，谦。君子以裒多益寡，称物平施。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 40,
  "huguaName": "雷水解",

  // ═════════════════════════════════════════════
  //  象课
