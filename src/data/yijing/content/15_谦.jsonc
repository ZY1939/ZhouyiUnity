  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "谦谦君子，用涉大川，吉。",
      "xiang": "“谦谦君子”，卑以自牧也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "鸣谦，贞吉。",
      "xiang": "“鸣谦，贞吉”，中心得也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "劳谦，君子有终，吉。",
      "xiang": "“劳谦君子”，万民服也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "无不利，撝谦。",
      "xiang": "“无不利，撝谦”，不违则也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "不富以其邻，利用侵伐，无不利。",
      "xiang": "“利用侵伐”，征不服也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "鸣谦，利用行师，征邑国。",
      "xiang": "“鸣谦”，志未得也；可“用行师”，“征邑国”也。",
      "nishi": "（待补充）"
    }
  ],
