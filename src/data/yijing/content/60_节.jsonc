  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "不出户庭，无咎。",
      "xiang": "“不出户庭”，知通塞也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "不出门庭，凶。",
      "xiang": "“不出门庭，凶”，失时极也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "不节若，则嗟若，无咎。",
      "xiang": "“不节”之“嗟”，又谁“咎”也？",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "安节，亨。",
      "xiang": "“安节”之“亨”，承上道也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "甘节，吉。往有尚。",
      "xiang": "“甘节”之“吉”，居位中也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "苦节，贞凶，悔亡。",
      "xiang": "“苦节，贞凶”，其道穷也。",
      "nishi": "（待补充）"
    }
  ],
