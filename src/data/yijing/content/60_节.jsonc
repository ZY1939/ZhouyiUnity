  "id": 60,
  "name": "节",
  "full_name": "水泽节",
  "symbol": "䷻",
  "binary": "110010",
  "upper": "坎",
  "lower": "兑",
  "scripture": "亨，苦节，不可贞。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "“节，亨”，刚柔分而刚得中。“苦节，不可贞”，其道穷也。说以行险，当位以节，中正以通。天地节而四时成；节以制度，不伤财，不害民。",
  "daxiang": "泽上有水，节。君子以制数度，议德行。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 27,
  "huguaName": "山雷颐",

  // ═════════════════════════════════════════════
  //  象课
  // ═════════════════════════════════════════════
