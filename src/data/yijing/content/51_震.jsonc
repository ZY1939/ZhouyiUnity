  "id": 51,
  "name": "震",
  "full_name": "震为雷",
  "symbol": "䷲",
  "binary": "100100",
  "upper": "震",
  "lower": "震",
  "scripture": "亨。震来虩虩，笑言哑哑。震惊百里，不丧匕鬯。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "震，亨。“震来虩虩”，恐致福也；“笑言哑哑”，后有则也。“震惊百里”，惊远而惧迩也；出可以守宗庙社稷，以为祭主也。",
  "daxiang": "洊雷，震。君子以恐惧修省。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 39,
  "huguaName": "水山蹇",

