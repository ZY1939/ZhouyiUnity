  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "干父之蛊，有子，考无咎，厉终吉。",
      "xiang": "“干父之蛊”，意承考也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "干母之蛊，不可贞。",
      "xiang": "“干母之蛊”，得中道也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "干父之蛊，小有悔，无大咎。",
      "xiang": "“干父之蛊”，终“无咎”也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "裕父之蛊，往见吝。",
      "xiang": "“裕父之蛊”，往未得也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "干父之蛊，用誉。",
      "xiang": "“干父”“用誉”，承以德也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "不事王侯，高尚其事。",
      "xiang": "“不事王侯”，志可则也。",
      "nishi": "（待补充）"
    }
  ],
