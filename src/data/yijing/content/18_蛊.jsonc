  "id": 18,
  "name": "蛊",
  "full_name": "山风蛊",
  "symbol": "䷑",
  "binary": "011001",
  "upper": "艮",
  "lower": "巽",
  "scripture": "元亨，利涉大川。先甲三日，后甲三日。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "蛊，刚上而柔下，巽而止，蛊。蛊，“元亨”，而天下治也。“利涉大川”，往有事也。“先甲三日，后甲三日”，终则有始，天行也。",
  "daxiang": "山下有风，蛊。君子以振民育德。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 54,
  "huguaName": "雷泽归妹",

