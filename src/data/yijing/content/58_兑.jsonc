  "lines": [
    {
      "attribute": "初九",
      "scripture": "和兑，吉。",
      "xiang": "“和兑”之“吉”，行未疑也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "孚兑，吉，悔亡。",
      "xiang": "“孚兑”之“吉”，信志也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "来兑，凶。",
      "xiang": "“来兑”之“凶”，位不当也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "商兑未宁，介疾有喜。",
      "xiang": "九四之“喜”，有庆也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "孚于剥，有厉。",
      "xiang": "“孚于剥”，位正当也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "引兑。",
      "xiang": "上六“引兑”，未光也。",
      "nishi": "（待补充）"
    }
  ],
