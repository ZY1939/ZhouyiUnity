  "id": 36,
  "name": "明夷",
  "full_name": "地火明夷",
  "symbol": "䷣",
  "binary": "101000",
  "upper": "坤",
  "lower": "离",
  "scripture": "利艰贞。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "明入地中，“明夷”。内文明而外柔顺，以蒙大难，文王以之。“利艰贞”，晦其明也；内难而能正其志，箕子以之。",
  "daxiang": "明入地中，明夷。君子以莅众，用晦而明。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 40,
  "huguaName": "雷水解",

