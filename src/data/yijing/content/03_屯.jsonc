  "id": 3,
  "name": "屯",
  "full_name": "水雷屯",
  "symbol": "䷂",
  "binary": "100010",
  "upper": "坎",
  "lower": "震",
  "scripture": "元亨，利贞；勿用有攸往，利建侯。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "屯，刚柔始交而难生。动乎险中，大亨贞。雷雨之动满盈，天造草昧，宜建侯而不宁。",
  "daxiang": "云雷，屯。君子以经纶。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 23,
  "huguaName": "山地剥",

  // ═════════════════════════════════════════════
  //  象课
  // ═════════════════════════════════════════════
  "xiang_ke": {
    "xiang": "（待补充）",
    "ke": "（待补充）"
  },

  // ═════════════════════════════════════════════
  //  倪师卦解、占卜、阳宅、批八字
  // ═════════════════════════════════════════════
  "nishi": {
    "interpretation": "",
    "diagram": {
      "description": [
        "一、人在望竿頭上立:此不明局勢之屯難時也,不可妄動也。",
        "二、犬上回字:乃肖狗之人,狗年,狄姓之人,果為哭之象。",
        "三、車在泥中:進退兩難之象。刀在牛上:解也,牛為貴人象。",
        "四、人射文書:張姓,小人阻礙也。射:同音,色也,緋聞。",
        "五、牛不順道:背道而馳,反其道而為之,吉。",
        "六、人望:人亡也。 七、人立:在位也。",
        "八、盒:先成後破。",
        "九、牛回頭視犬:計無所出,待也。"
      ],
      "image_path": ""
    },
    "home": {
      "member": "中男",
      "direction": "东",
      "description": []
    },
    "bazi": {
      "young": "",
      "old": "",
      "year": ""
    }
  },
  "history": [
    {
      "source": "",
      "dynasty": "",
      "description": "（待补充）"
    }
  ],

  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "磐桓；利居贞，利建侯。",
      "xiang": "虽磐桓，志行正也；以贵下贱，大得民也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "屯如，邅如，乘马班如。匪寇婚媾。女子贞不字，十年乃字。",
      "xiang": "六二之难，乘刚也。“十年乃字”，反常也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "即鹿无虞，惟入于林中，君子几，不如舍，往吝。",
      "xiang": "“即鹿无虞”，以从禽也。君子舍之；“往吝”，穷也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "乘马班如，求婚媾，往吉，无不利。",
      "xiang": "“求”而“往”，明也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "屯其膏，小贞吉，大贞凶。",
      "xiang": "“屯其膏”，施未光也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "乘马班如，泣血涟如。",
      "xiang": "“泣血涟如”，何可长也？",
      "nishi": "（待补充）"
    }
  ],
  "": {
  },
  "{path}": ["一、人在望竿頭上立:此不明局勢之屯難時也,不可妄動也。", "二、犬上回字:乃肖狗之人,狗年,狄姓之人,果為哭之象。", "三、車在泥中:進退兩難之象。刀在牛上:解也,牛為貴人象。", "四、人射文書:張姓,小人阻礙也。射:同音,色也,緋聞。", "五、牛不順道:背道而馳,反其道而為之,吉。", "六、人望:人亡也。 七、人立:在位也。", "八、盒:先成後破。", "九、牛回頭視犬:計無所出,待也。"]
