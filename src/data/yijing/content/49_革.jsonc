  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "巩用黄牛之革。",
      "xiang": "“巩用黄牛”，不可以有为也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "巳日乃革之，征吉，无咎。",
      "xiang": "“巳日”“革之”，行有嘉也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "征凶，贞厉；革言三就，有孚。",
      "xiang": "“革言三就”，又何之矣！",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "悔亡，有孚改命，吉。",
      "xiang": "“改命”之“吉”，信志也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "大人虎变，未占有孚。",
      "xiang": "“大人虎变”，其文炳也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "君子豹变，小人革面；征凶，居贞吉。",
      "xiang": "“君子豹变”，其文蔚也；“小人革面”，顺以从君也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
  },
  "{path}": ["一、一人把柿全,乃人肺腑之言。", "二、一人把柿不全,一人半真言也。", "三、一兔:躍進之象。", "四、一虎:威權之象,大人之象,肖虎也。", "五、官人推車有一印:如為武官,則訟至。今為文官帶印,主得掛印封帥,須力求變革,果必成。丈夫推車,乃求婚也,帶印必成。", "六、虎兔向山行:賢良大人退,後繼有人躍進同行。", "七、山頭四點:上位之人,黑暗不明之象。", "八、大路:轉變為新且順之象。"]
