  "nishi": {
    "interpretation": "",
    "diagram": {
      "description": [
        "一、雲中雁傳書:飛來喜訊象。",
        "二、一堆錢:財聚也。",
        "三、朱門內有人坐:君王之象,必見君面也。",
        "四、一人在鬥外立地:乃士人求仕,受尊重之象。",
        "五、串錢在地:有用利不行之象。",
        "六、亂珠聚盆:先聚後散之象。"
      ],
      "image_path": ""
    },
