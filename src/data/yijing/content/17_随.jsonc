  "id": 17,
  "name": "随",
  "full_name": "泽雷随",
  "symbol": "䷐",
  "binary": "100110",
  "upper": "兑",
  "lower": "震",
  "scripture": "元亨，利贞，无咎。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "随，刚来而下柔，动而说，随。大亨，贞，“无咎”，而天下随时。随之时义大矣哉！",
  "daxiang": "泽中有雷，随。君子以向晦入宴息。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 53,
  "huguaName": "风山渐",

