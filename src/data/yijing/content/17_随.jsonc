  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "官有渝，贞吉；出门交有功。",
      "xiang": "“官有渝”，从正“吉”也；“出门交有功”，不失也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "系小子，失丈夫。",
      "xiang": "“系小子”，弗兼与也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "系丈夫，失小子；随有求得，利居贞。",
      "xiang": "“系丈夫”，志舍下也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "随有获，贞凶；有孚在道，以明，何咎？",
      "xiang": "“随有获”，其义“凶”也；“有孚在道”，明功也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "孚于嘉，吉。",
      "xiang": "“孚于嘉，吉”，位正中也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "拘系之，乃从维之；王用亨于西山。",
      "xiang": "“拘系之”，上穷也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
