  "lines": [
    {
      "attribute": "初九",
      "scripture": "屦校灭趾，无咎。",
      "xiang": "“屦校灭趾”，不行也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "噬肤灭鼻，无咎。",
      "xiang": "“噬肤灭鼻”，乘刚也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "噬腊肉，遇毒；小吝，无咎。",
      "xiang": "“遇毒”，位不当也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "噬干胏，得金矢；利艰贞，吉。",
      "xiang": "“利艰贞吉”，未光也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "噬干肉，得黄金，贞厉，无咎。",
      "xiang": "“贞厉无咎”，得当也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "何校灭耳，凶。",
      "xiang": "“何校灭耳”，聪不明也。",
      "nishi": "（待补充）"
    }
  ],
