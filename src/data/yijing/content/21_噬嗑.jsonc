  "upper": "离",
  "lower": "震",
  "scripture": "亨，利用狱。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "颐中有物，曰噬嗑。噬嗑而亨，刚柔分，动而明，雷电合而章。柔得中而上行，虽不当位，“利用狱”也。",
  "daxiang": "雷电，噬嗑。先王以明罚敕法。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 39,
  "huguaName": "水山蹇",

