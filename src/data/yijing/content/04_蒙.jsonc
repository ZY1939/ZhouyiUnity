  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "发蒙，利用刑人，用说桎梏；以往吝。",
      "xiang": "“利用刑人”，以正法也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九二",
      "scripture": "包蒙，吉。纳妇，吉；子克家。",
      "xiang": "“子克家”，刚柔接也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "勿用取女，见金夫，不有躬，无攸利。",
      "xiang": "“勿用取女”，行不顺也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "困蒙，吝。",
      "xiang": "“困蒙”之“吝”，独远实也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "童蒙，吉。",
      "xiang": "“童蒙”之“吉”，顺以巽也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "击蒙；不利为寇，利御寇。",
      "xiang": "“利”用“御寇”，上下顺也。",
      "nishi": "（待补充）"
    }
  ],
