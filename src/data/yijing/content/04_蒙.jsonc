  "id": 4,
  "name": "蒙",
  "full_name": "山水蒙",
  "symbol": "䷃",
  "binary": "010001",
  "upper": "艮",
  "lower": "坎",
  "scripture": "亨。匪我求童蒙，童蒙求我。初筮告，再三渎，渎则不告。利贞。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "蒙，山下有险，险而止，蒙。“蒙亨”，以亨行，时中也。“匪我求童蒙，童蒙求我”，志应也。“初筮告”，以刚中也。“再三渎，渎则不告”，渎蒙也。蒙以养正，圣功也。",
  "daxiang": "山下出泉，蒙。君子以果行育德。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 24,
  "huguaName": "地雷复",

  // ═════════════════════════════════════════════
  //  象课
  // ═════════════════════════════════════════════
