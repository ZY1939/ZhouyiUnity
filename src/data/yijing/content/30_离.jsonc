  "lines": [
    {
      "attribute": "初九",
      "scripture": "履错然，敬之，无咎。",
      "xiang": "“履错”之“敬”，以辟咎也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "黄离，元吉。",
      "xiang": "“黄离，元吉”，得中道也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "日昃之离，不鼓缶而歌，则大耋之嗟，凶。",
      "xiang": "“日昃之离”，何可久也！",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "突如其来如，焚如，死如，弃如。",
      "xiang": "“突如其来如”，无所容也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "出涕沱若，戚嗟若，吉。",
      "xiang": "六五之“吉”，离王公也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "王用出征，有嘉折首，获匪其丑，无咎。",
      "xiang": "“王用出征”，以正邦也。",
      "nishi": "（待补充）"
    }
  ],
