  "id": 30,
  "name": "离",
  "full_name": "离为火",
  "fullName_tc": "離爲火",
  "symbol": "䷝",
  "binary": "101101",
  "upper": "离",
  "lower": "离",
  "scripture": "利贞，亨。畜牝牛，吉。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "离，丽也；日月丽乎天，百谷草木丽乎土。重明以丽乎正，乃化成天下。柔丽乎中正，故“亨”，是以“畜牝牛，吉”也。",
  "daxiang": "明两作，离。大人以继明照于四方。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 28,
  "huguaName": "泽风大过",

  // ═════════════════════════════════════════════
  //  象课
  // ═════════════════════════════════════════════
  "xiang_ke": {
    "xiang": "飛禽在網之課",
    "ke": "大明當天之象"
  },

  // ═════════════════════════════════════════════
  //  倪师卦解、占卜、阳宅、批八字
  // ═════════════════════════════════════════════
  "nishi": {
    "interpretation": "陷於險難之中,必有所附麗,理之自然,離者麗也。離為火,火體中虛而能明照,故能麗 於物而明也。人之明,必經險難,大風大浪過後,其經驗之累積,而後能明,此猶可人。\n\n今人雖歷災險,但仍不能明,吾人教授易經,其目的即希望世人,不須付出血的代價,亦 能明,此中虛之廣義。\n",
    "diagram": {
      "description": [
        "一、人在虎背上立:行危不懼;難下也。",
        "二、 一船在江心:口舌相爭,無所適從也。",
        "三、官人執箭岸上立:在位之人,欲殺之象。"
      ],
      "image_path": "",
      "content": "人在虎背上立,官人執箭在岸上立 人在虎背上立,官人執箭在岸上立人在虎背上立,官人執箭在岸上立,水 中有船,二人分立兩岸。 中有船,二人分立兩岸。"
    },
    "home": {
      "member": "中女",
      "direction": "南",
      "description": []
    },
    "heluo": {
      "xiantian": [
        "先天卦碰到这种人呢。",
        "第一个，性喜飘荡，无所适从，到处飘荡，也不喜欢待在家里边，到处跑来跑去。这个是不是，雨中鸡啊，或者是鹤，那么鸡啊鹤啊，腿很长啊，清清瘦瘦的那个毛干干的，你看那个人没有下雨啊，站在那边好像雨中的鸡，雨中的鹤一样，这种就是这样。",
        "第二个，父留母失，两地相隔，跟妈妈，爸爸妈妈分开来。",
        "第三个，这种人呢，往往文章才艺呢，非常的出众，才艺啊， 非常的出众，比如说，文章才艺出众。但是不聚财，这种往往都是一辈子捧着饭碗走天下，就是这样子。",
        "第四个，然后婚姻方面呢，结而离，然后结了离，离了又结，婚事无定居，婚姻都不会固定在那边。"
      ],
      "houtian": [
        "后天卦，进入这个的时候。",
        "第一个，诸位你要提醒他，他一定茫然不知所措，你要告诉他，虽无方向，但是你要记得行危不惧，如果遇到危险不要怕，危险还没有到的时候，你就开始怕了，就已经危险了，怕就是危险。这个，去吉，止凶。遇到危险的时候，要进，不能停，不是进就是退，但是绝对不能停下来，遇到任何的危险，事情来的时候，你一止就是凶，那个止的时候就是凶啊。",
        "第二个，婚呢，有失妻之虑，太太会失去掉。",
        "第三个，如果刚刚好，那一年，这是特例的啊，那一年，寅年呢，遇虎，有大变，不是厕所里的大便，是大变化。财散人离，那一年流年卦刚好是寅年，然后你本身又属虎，或者是姓王，好，出现这个，不是每一个人都有这种现象的。"
      ],
      "liunian": [
        "进入流年卦的时候，流年我们怎么批?",
        "第一个，心有忧虑，方向不明，那一年逢到之后，一样你要劝他，行为不惧方是真，你不要怕。",
        "第二个，那个人呢，我是当官的，从官的话，那一年遇到，会逢暗箭伤人。",
        "第三个，然后那一年的流年，遇到这一年的流年的时候，财禄，婚事，就是事业跟家庭，两不吉，两件事情都不会顺利。那你流年逢的时候可以去投资，买股票啊，或者是投资什么的话，那你投资自己会招凶。"
      ]
    }
  },
  "history": [
    {
      "source": "",
      "dynasty": "",
      "description": "此卦朱買臣被妻棄時,卜得之,知身必貴也。"
    }
  ],
  "lines": [
    {
      "attribute": "初九",
      "scripture": "履错然，敬之，无咎。",
      "xiang": "“履错”之“敬”，以辟咎也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "黄离，元吉。",
      "xiang": "“黄离，元吉”，得中道也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "日昃之离，不鼓缶而歌，则大耋之嗟，凶。",
      "xiang": "“日昃之离”，何可久也！",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "突如其来如，焚如，死如，弃如。",
      "xiang": "“突如其来如”，无所容也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六五",
      "scripture": "出涕沱若，戚嗟若，吉。",
      "xiang": "六五之“吉”，离王公也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "王用出征，有嘉折首，获匪其丑，无咎。",
      "xiang": "“王用出征”，以正邦也。",
      "nishi": "（待补充）"
    }
  ]
}
