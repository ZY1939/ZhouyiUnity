  "upper": "离",
  "lower": "离",
  "scripture": "利贞，亨。畜牝牛，吉。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "离，丽也；日月丽乎天，百谷草木丽乎土。重明以丽乎正，乃化成天下。柔丽乎中正，故“亨”，是以“畜牝牛，吉”也。",
  "daxiang": "明两作，离。大人以继明照于四方。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 28,
  "huguaName": "泽风大过",

