  "id": 5,
  "name": "需",
  "full_name": "水天需",
  "symbol": "䷄",
  "binary": "111010",
  "upper": "坎",
  "lower": "乾",
  "scripture": "有孚，光亨，贞吉，利涉大川。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "“需”，须也；险在前也。刚健而不陷，其义不困穷矣。“需，有孚，光亨，贞吉”，位乎天位，以正中也。“利涉大川”，往有功也。",
  "daxiang": "云上于天，需。君子以饮食宴乐。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 38,
  "huguaName": "火泽睽",

  // ═════════════════════════════════════════════
  //  象课
  // ═════════════════════════════════════════════
