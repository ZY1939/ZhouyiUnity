  "id": 13,
  "name": "同人",
  "full_name": "天火同人",
  "symbol": "䷌",
  "binary": "101111",
  "upper": "乾",
  "lower": "离",
  "scripture": "同人于野，亨。利涉大川，利君子贞。",

  // ═════════════════════════════════════════════
  //  彖传 / 大象传
  // ═════════════════════════════════════════════
  "tuan": "同人，柔得位得中而应乎乾，曰同人。同人曰：“同人于野，亨。利涉大川”，乾行也。文明以健，中正而应。“君子”，正也。唯君子为能通天下之志。",
  "daxiang": "天与火，同人。君子以类族辨物。",

  // ═════════════════════════════════════════════
  //  互卦
  // ═════════════════════════════════════════════
  "huguaId": 44,
  "huguaName": "天风姤",

  // ═════════════════════════════════════════════
  //  象课
  // ═════════════════════════════════════════════
