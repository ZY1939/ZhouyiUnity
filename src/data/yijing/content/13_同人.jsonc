  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初九",
      "scripture": "同人于门，无咎。",
      "xiang": "出门同人，又谁“咎”也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "同人于宗，吝。",
      "xiang": "“同人于宗”，吝道也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九三",
      "scripture": "伏戎于莽，升其高陵，三岁不兴。",
      "xiang": "“伏戎于莽”，敌刚也；“三岁不兴”，安行也？",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九四",
      "scripture": "乘其墉，弗克攻，吉。",
      "xiang": "“乘其墉”，义弗克也；其吉，则困而反则也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "同人，先号咷，而后笑，大师克相遇。",
      "xiang": "“同人”之先，以中直也。大师相遇，言相克也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上九",
      "scripture": "同人于郊，无悔。",
      "xiang": "“同人于郊”，志未得也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
