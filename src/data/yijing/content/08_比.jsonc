  // ═════════════════════════════════════════════
  //  爻辞
  // ═════════════════════════════════════════════
  "lines": [
    {
      "attribute": "初六",
      "scripture": "有孚比之，无咎；有孚盈缶，终来有它，吉。",
      "xiang": "比之初六，有它吉也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六二",
      "scripture": "比之自内，贞吉。",
      "xiang": "“比之自内”，不自失也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六三",
      "scripture": "比之匪人。",
      "xiang": "“比之匪人”，不亦伤乎！",
      "nishi": "（待补充）"
    },
    {
      "attribute": "六四",
      "scripture": "外比之，贞吉。",
      "xiang": "“外比”于贤，以从上也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "九五",
      "scripture": "显比；王用三驱，失前禽。邑人不诫，吉。",
      "xiang": "“显比”之吉，位正中也。舍逆取顺，“失前禽”也。“邑人不诫”，上使中也。",
      "nishi": "（待补充）"
    },
    {
      "attribute": "上六",
      "scripture": "比之无首，凶。",
      "xiang": "“比之无首”，无所终也。",
      "nishi": "（待补充）"
    }
  ],
  "": {
